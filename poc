#!/usr/bin/env bash
# Compute Factory POC lifecycle.
#   ./poc up       create everything (assumes a clean slate)
#   ./poc down     destroy everything, including user VMs, then verify nothing tagged cf:poc=true remains
#   ./poc status   read-only overview
#   ./poc deploy-idp [<image-id>]  deploy to the existing host, building only when no artifact is supplied
#   ./poc prune-idp-images        explicitly collect old IDP registry blobs and dangling IDP images
#   ./poc watch-bake <run-id>   monitor an existing bake without dispatching another
#   ./poc set-password <user>   add/change an IDP login (hash stored in .poc-users)
#   ./poc logs [backstage|caddy|postgres|all] [since]   IDP container logs (default: backstage, 30m)
#   ./poc task <task-id>        Scaffolder task status and stored events, straight from Postgres
#   ./poc run <run-id>          VM orchestrator run and stage state, straight from Postgres
# See DESIGN.md section 12.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
PROJECTS="$(dirname "$ROOT")"
OWNER="amirasyraf"
DOMAIN="idp.amirasyraf.dev"
BUILDER_REPO="$OWNER/compute-factory-builder"
PLATFORM_REPO="$OWNER/compute-factory-platform"
PLATFORM_DIR="$PROJECTS/compute-factory-platform"
IDP_DIR="$PROJECTS/compute-factory-idp"
CF_DNS_DIR="$HOME/projects/cloudflare/amirasyraf.dev"
INFRA_DIR="$ROOT/infra"
GEN="$ROOT/.generated"
HEALTH_URL="https://$DOMAIN/.backstage/health/v1/readiness"
USERS_FILE="$ROOT/.poc-users" # username:scrypt-hash lines, gitignored, persists across cycles
PASSWORDS_FILE="$ROOT/.poc-passwords" # username:plaintext, gitignored; POC test logins for agents/scripts
PARALLEL_DESTROYS="${PARALLEL_DESTROYS:-5}"
RUN_CANCEL_TIMEOUT=900
CLEAN_STABILITY_PASSES=3
CLEAN_STABILITY_SECONDS=30
AWS_REGION_PARALLEL=5
POC_LOCK_DIR="$GEN/poc.lock"
MAINTENANCE_VARIABLE="CF_POC_MAINTENANCE"

export AWS_PROFILE="${AWS_PROFILE:-amirasyraf}"
POC_AWS_REGION="ap-southeast-2"
export AWS_REGION="$POC_AWS_REGION" AWS_DEFAULT_REGION="$POC_AWS_REGION"
export AWS_PAGER="" AWS_CLI_TELEMETRY=0
AZURE_SUBSCRIPTION="74b39a79-f79d-4adb-8ae0-fe9118fc564a"
WORKFLOW_SPECS=("$BUILDER_REPO:bake.yml" "$PLATFORM_REPO:stage.yml")
export TF_IN_AUTOMATION=1 TF_INPUT=0
export TF_PLUGIN_CACHE_DIR="$GEN/tf-plugin-cache"
mkdir -p "$GEN/logs" "$TF_PLUGIN_CACHE_DIR"

SSH_OPTS=(-i "$HOME/.ssh/id_ed25519" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10)

log()  { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
info() { printf '    %s\n' "$*"; }
warn() { printf '    \033[33mWARN: %s\033[0m\n' "$*" >&2; }
die()  { printf '\033[31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }

acquire_poc_lock() {
  if ! mkdir "$POC_LOCK_DIR" 2>/dev/null; then
    local owner
    owner="$(cat "$POC_LOCK_DIR/pid" 2>/dev/null || true)"
    die "POC lifecycle lock is held${owner:+ by PID $owner}; refusing to continue"
  fi
  printf '%s\n' "$$" >"$POC_LOCK_DIR/pid"
  trap 'rm -rf "$POC_LOCK_DIR"' EXIT
  trap 'rm -rf "$POC_LOCK_DIR"; exit 130' INT
  trap 'rm -rf "$POC_LOCK_DIR"; exit 143' TERM
}

tf_infra()  { terraform -chdir="$INFRA_DIR" "$@"; }
infra_out() { tf_infra output -raw "$1" 2>/dev/null || true; }
infra_has_state() { [[ -n "$(tf_infra state list 2>/dev/null || true)" ]]; }

require_tools() {
  local t
  for t in terraform gh aws az jq ssh git curl "$@"; do
    command -v "$t" >/dev/null || die "missing tool: $t"
  done
  local acct
  acct="$(aws sts get-caller-identity --query Account --output text 2>/dev/null)" || die "AWS profile $AWS_PROFILE not usable (aws sso login?)"
  [[ "$acct" == "134584031874" ]] || die "AWS profile $AWS_PROFILE points at $acct, expected 134584031874"
  gh auth status >/dev/null 2>&1 || die "gh is not authenticated"
  # The sweeps use the az CLI. Terraform's azurerm provider needs ARM_* only for
  # `up` and for destroying an existing local infra state; see DESIGN.md §9.
  [[ "$(az account show --query id -o tsv 2>/dev/null)" == "$AZURE_SUBSCRIPTION" ]] || die "az CLI not logged in to subscription $AZURE_SUBSCRIPTION (run azsp)"
}

require_terraform_azure_auth() {
  export ARM_TENANT_ID="${ARM_TENANT_ID:-c26545da-80fa-4c31-9a8f-a4ae475bd17e}"
  export ARM_SUBSCRIPTION_ID="${ARM_SUBSCRIPTION_ID:-$AZURE_SUBSCRIPTION}"
  export ARM_CLIENT_ID="${ARM_CLIENT_ID:-b6a2750b-5b51-487a-8903-d01c0a00a4e2}"
  export ARM_CLIENT_CERTIFICATE_PATH="${ARM_CLIENT_CERTIFICATE_PATH:-$HOME/.config/azure/cf-admin-local.pfx}"
  export ARM_CLIENT_CERTIFICATE_PASSWORD="${ARM_CLIENT_CERTIFICATE_PASSWORD:-}"
  [[ -f "$ARM_CLIENT_CERTIFICATE_PATH" ]] \
    || die "Terraform Azure certificate not found at $ARM_CLIENT_CERTIFICATE_PATH (cf-admin-local)"
}

set_maintenance_gate() {
  local value="$1" repo
  for repo in "$BUILDER_REPO" "$PLATFORM_REPO"; do
    gh variable set "$MAINTENANCE_VARIABLE" -R "$repo" -b "$value" >/dev/null \
      || die "could not set $MAINTENANCE_VARIABLE=$value on $repo; refusing to continue"
  done
}

verify_maintenance_gate() {
  local repo value
  for repo in "$BUILDER_REPO" "$PLATFORM_REPO"; do
    value="$(gh variable get "$MAINTENANCE_VARIABLE" -R "$repo" 2>&1)" \
      || { warn "could not read $MAINTENANCE_VARIABLE on $repo: $value"; return 1; }
    [[ "$value" == 1 ]] \
      || { warn "$MAINTENANCE_VARIABLE on $repo is '$value', expected 1"; return 1; }
  done
}

ensure_repos() {
  local r
  for r in compute-factory-idp compute-factory-builder compute-factory-platform; do
    if [[ ! -d "$PROJECTS/$r/.git" ]]; then
      git clone -q "git@github.com:$OWNER/$r.git" "$PROJECTS/$r"
    else
      git -C "$PROJECTS/$r" pull -q --rebase || warn "could not update $r (local changes?) - using working copy as is"
    fi
  done
}

# Replace vms/ in the platform repo with an empty inventory, using a throwaway clone.
reset_inventory() {
  local tmp
  tmp="$(mktemp -d)"
  git clone -q --depth 1 "git@github.com:$PLATFORM_REPO.git" "$tmp/p"
  (
    cd "$tmp/p"
    git rm -rq --ignore-unmatch vms
    mkdir -p vms && touch vms/.gitkeep && git add vms/.gitkeep
    if ! git diff --cached --quiet; then
      git commit -qm "poc: reset VM inventory" && git push -q && echo "    inventory reset"
    else
      echo "    inventory already empty"
    fi
  )
  rm -rf "$tmp"
}

