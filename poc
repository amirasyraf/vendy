export AWS_MAX_ATTEMPTS="${AWS_MAX_ATTEMPTS:-3}"
AZURE_SUBSCRIPTION="74b39a79-f79d-4adb-8ae0-fe9118fc564a"
AZURE_TENANT="c26545da-80fa-4c31-9a8f-a4ae475bd17e"
STATE_BUCKET="cf-tfstate-${POC_AWS_ACCOUNT}-apse2"
WORKFLOW_SPECS=("$BUILDER_REPO:bake.yml" "$PLATFORM_REPO:stage.yml")
