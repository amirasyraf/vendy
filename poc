#!/usr/bin/env bash
# Compute Factory POC lifecycle.
#   ./poc up       create everything (assumes a clean slate)
#   ./poc down     destroy everything, including user VMs, then verify nothing tagged cf:poc=true remains
#   ./poc status   read-only overview
#   ./poc deploy-idp [<image-id>]  deploy to the existing host, building only when no artifact is supplied
#   ./poc prune-idp-images        explicitly collect old IDP registry blobs and dangling IDP images
#   ./poc watch-bake <run-id>   monitor an existing bake without dispatching another
#   ./poc set-password <user>   add/change an IDP login (hash stored in .poc-users)
#   ./poc logs [backstage|caddy|postgres|all] [since]   IDP container logs (default: backstage, 30m)
#   ./poc task <task-id>        Scaffolder task status and stored events, straight from Postgres
#   ./poc run <run-id>          VM orchestrator run and stage state, straight from Postgres
# See DESIGN.md section 12.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
PROJECTS="$(dirname "$ROOT")"
OWNER="amirasyraf"
DOMAIN="idp.amirasyraf.dev"
BUILDER_REPO="$OWNER/compute-factory-builder"
PLATFORM_REPO="$OWNER/compute-factory-platform"
PLATFORM_DIR="$PROJECTS/compute-factory-platform"
IDP_DIR="$PROJECTS/compute-factory-idp"
CF_DNS_DIR="$HOME/projects/cloudflare/amirasyraf.dev"
INFRA_DIR="$ROOT/infra"
GEN="$ROOT/.generated"
HEALTH_URL="https://$DOMAIN/.backstage/health/v1/readiness"
USERS_FILE="$ROOT/.poc-users" # username:scrypt-hash lines, gitignored, persists across cycles
PASSWORDS_FILE="$ROOT/.poc-passwords" # username:plaintext, gitignored; POC test logins for agents/scripts
PARALLEL_DESTROYS="${PARALLEL_DESTROYS:-5}"
RUN_CANCEL_TIMEOUT=900
CLEAN_STABILITY_PASSES=3
CLEAN_STABILITY_SECONDS=30
CLEAN_TIMEOUT=240
AWS_REGION_PARALLEL=5
POC_LOCK_FILE="$HOME/.cache/compute-factory/lifecycle.lock"
MAINTENANCE_VARIABLE="CF_POC_MAINTENANCE"
POC_AWS_ACCOUNT="134584031874"

POC_AWS_PROFILE="${AWS_PROFILE:-amirasyraf}"
export AWS_PROFILE="$POC_AWS_PROFILE"
POC_AWS_REGION="ap-southeast-2"
export AWS_REGION="$POC_AWS_REGION" AWS_DEFAULT_REGION="$POC_AWS_REGION"
export AWS_PAGER="" AWS_CLI_TELEMETRY=0
AZURE_SUBSCRIPTION="74b39a79-f79d-4adb-8ae0-fe9118fc564a"
AZURE_TENANT="c26545da-80fa-4c31-9a8f-a4ae475bd17e"
STATE_BUCKET="cf-tfstate-${POC_AWS_ACCOUNT}-apse2"
WORKFLOW_SPECS=("$BUILDER_REPO:bake.yml" "$PLATFORM_REPO:stage.yml")
export TF_IN_AUTOMATION=1 TF_INPUT=0

SSH_OPTS=(-i "$HOME/.ssh/id_ed25519" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3)

log()  { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
info() { printf '    %s\n' "$*"; }
warn() { printf '    \033[33mWARN: %s\033[0m\n' "$*" >&2; }
die()  { printf '\033[31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }

locked() {
  [[ "${CF_POC_LOCK_HELD:-}" == 1 ]] || return 1
  python3 -c '
import os, sys
try:
    fd, path = os.fstat(9), os.stat(sys.argv[1])
except OSError:
    sys.exit(1)
sys.exit(0 if os.path.samestat(fd, path) else 1)
' "$POC_LOCK_FILE"
}

acquire_poc_lock() {
  locked && return 0
  command -v python3 >/dev/null || die "missing tool: python3"
  exec python3 -c '
import fcntl, os, sys
path, script, *args = sys.argv[1:]
os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    sys.exit("POC lifecycle lock is held; another command or its workers are still running")
if fd != 9:
    os.dup2(fd, 9, inheritable=True)
    os.close(fd)
else:
    os.set_inheritable(fd, True)
# The kernel releases the lock only when the last inheriting process exits.
os.environ["CF_POC_LOCK_HELD"] = "1"
os.execvp("bash", ["bash", script, *args])
' "$POC_LOCK_FILE" "$ROOT/poc" "$@"
}

prepare_lifecycle() {
  local name
  # Do not let a caller silently redirect a lifecycle command to another state or
  # append -target, -lock=false, etc. to the commands checked below.
  for name in "${!TF_CLI_ARGS@}" "${!TF_VAR_@}"; do
    [[ -z "${!name}" ]] || die "$name is not supported for POC lifecycle commands"
  done
  [[ "${TF_WORKSPACE:-default}" == default ]] || die "POC lifecycle uses only the default Terraform workspace"
  unset TF_DATA_DIR
  export TF_WORKSPACE=default
  umask 077
  mkdir -p "$GEN/logs"
  chmod 700 "$GEN" "$GEN/logs"
}

tf_infra()  { TF_DATA_DIR="$INFRA_DIR/.terraform" terraform -chdir="$INFRA_DIR" "$@"; }
infra_out() { tf_infra output -raw "$1" 2>/dev/null || true; }
infra_state() {
  [[ ! -L "$INFRA_DIR/terraform.tfstate" ]] || { warn "refusing a symlinked local Terraform state"; return 1; }
  [[ -e "$INFRA_DIR/terraform.tfstate" ]] || return 0
  tf_infra state list
}
az_poc() { az "$@" --subscription "$AZURE_SUBSCRIPTION" --only-show-errors; }

require_tools() {
  local t
  for t in terraform gh aws az jq ssh git curl xargs "$@"; do
    command -v "$t" >/dev/null || die "missing tool: $t"
  done
  local acct
  acct="$(aws sts get-caller-identity --query Account --output text 2>/dev/null)" || die "AWS profile $AWS_PROFILE not usable (aws sso login?)"
  [[ "$acct" == "$POC_AWS_ACCOUNT" ]] || die "AWS profile $AWS_PROFILE points at $acct, expected $POC_AWS_ACCOUNT"
  gh auth status >/dev/null 2>&1 || die "gh is not authenticated"
  # The sweeps use the az CLI. Terraform's azurerm provider needs ARM_* only for
  # `up` and for destroying an existing local infra state; see DESIGN.md §9.
  [[ "$(az account show --query id -o tsv 2>/dev/null)" == "$AZURE_SUBSCRIPTION" ]] || die "az CLI not logged in to subscription $AZURE_SUBSCRIPTION (run azsp)"
}

require_terraform_azure_auth() {
  [[ "${ARM_TENANT_ID:-$AZURE_TENANT}" == "$AZURE_TENANT" ]] || { warn "ARM_TENANT_ID is not the POC tenant"; return 1; }
  [[ "${ARM_SUBSCRIPTION_ID:-$AZURE_SUBSCRIPTION}" == "$AZURE_SUBSCRIPTION" ]] || { warn "ARM_SUBSCRIPTION_ID is not the POC subscription"; return 1; }
  export ARM_TENANT_ID="$AZURE_TENANT" ARM_SUBSCRIPTION_ID="$AZURE_SUBSCRIPTION"
  export ARM_CLIENT_ID="${ARM_CLIENT_ID:-b6a2750b-5b51-487a-8903-d01c0a00a4e2}"
  export ARM_CLIENT_CERTIFICATE_PATH="${ARM_CLIENT_CERTIFICATE_PATH:-$HOME/.config/azure/cf-admin-local.pfx}"
  export ARM_CLIENT_CERTIFICATE_PASSWORD="${ARM_CLIENT_CERTIFICATE_PASSWORD:-}"
  [[ -r "$ARM_CLIENT_CERTIFICATE_PATH" ]] \
    || { warn "Terraform Azure certificate not readable: $ARM_CLIENT_CERTIFICATE_PATH"; return 1; }
}

set_maintenance_gate() {
  local value="$1" repo
  shift
  for repo in "$@"; do
    gh variable set "$MAINTENANCE_VARIABLE" -R "$repo" -b "$value" >/dev/null \
      || die "could not set $MAINTENANCE_VARIABLE=$value on $repo; refusing to continue"
  done
}

verify_maintenance_gate() {
  local expected="$1" repo value
  shift
  for repo in "$@"; do
    value="$(gh variable get "$MAINTENANCE_VARIABLE" -R "$repo" 2>&1)" \
      || { warn "could not read $MAINTENANCE_VARIABLE on $repo: $value"; return 1; }
    [[ "$value" == "$expected" ]] \
      || { warn "$MAINTENANCE_VARIABLE on $repo is '$value', expected $expected"; return 1; }
  done
}

ensure_repos() {
  local r
  for r in compute-factory-idp compute-factory-builder compute-factory-platform; do
    [[ -e "$PROJECTS/$r/.git" ]] || git clone -q "git@github.com:$OWNER/$r.git" "$PROJECTS/$r"
  done
}

verify_inventory_empty() {
  gh api "repos/$PLATFORM_REPO/contents/vms?ref=main" \
    | jq -e 'type == "array" and all(.[]; .name == ".gitkeep" and .type == "file")' >/dev/null
}

# Only down may clear the inventory, after the cloud and state checks have passed.
reset_inventory() (
  cd "$1" || return 1
  git rm -rq --ignore-unmatch vms || return 1
  mkdir -p vms && touch vms/.gitkeep && git add vms/.gitkeep || return 1
  if ! git diff --cached --quiet; then
    git commit -qm "poc: reset VM inventory" && git push -q origin HEAD:main || return 1
    info "inventory reset"
  fi
)

infra_apply_or_destroy() {
  tf_infra "$1" -auto-approve -input=false \
    -var "aws_profile=$POC_AWS_PROFILE" -var "region=$POC_AWS_REGION" \
    -var "azure_subscription_id=$AZURE_SUBSCRIPTION" -var "azure_tenant_id=$AZURE_TENANT" \
    -var "azure_location=australiaeast" -var "azure_reader_cert_path=../.poc-azure-reader.pem" \
    -var "admin_ssh_public_key_path=$HOME/.ssh/id_ed25519.pub"
}

