wait_for_ssh_ready() {
  local ip="$1"
  for _ in $(seq 1 60); do
    if ssh "${SSH_OPTS[@]}" "ubuntu@$ip" 'test -f /var/lib/cloud/instance/cf-idp-ready' 2>/dev/null; then
      return 0
    fi
    sleep 10
  done
  die "IDP host $ip not ready after 10 min"
}

dns_apply() { # $1 = ip or empty (remove)
  terraform -chdir="$CF_DNS_DIR" apply -auto-approve -input=false \
    -target=cloudflare_dns_record.idp -var "idp_ip=$1" >"$GEN/logs/dns.log" 2>&1 \
    || { cat "$GEN/logs/dns.log" >&2; return 1; }
}

write_idp_env() {
  local file=$1
  # shellcheck disable=SC1091
  set -a; source "$ROOT/.poc.env"; set +a
  umask 077
  cat >"$file" <<EOF
IDP_DOMAIN=$DOMAIN
IDP_USERS_B64=$(base64 <"$USERS_FILE" | tr -d '\n')
GITHUB_TOKEN=$GITHUB_TOKEN
POSTGRES_PASSWORD=$(tf_infra output -raw postgres_password)
BACKSTAGE_TOKEN=$(tf_infra output -raw backstage_token)
AWS_REGION=$AWS_REGION
SSH_CA_SECRET_ID=$(infra_out ssh_ca_secret_id)
AZURE_READER_SECRET_ID=$(infra_out azure_reader_secret_id)
EOF
}

watch_bake() {
  local id="${1:-}" result status conclusion errors=0 deadline=$((SECONDS + 3600))
  [[ "$id" =~ ^[1-9][0-9]*$ ]] || die "usage: $0 watch-bake <run-id>"
  echo "bake run: https://github.com/$BUILDER_REPO/actions/runs/$id"
  while (( SECONDS < deadline )); do
    if result="$(gh run view "$id" -R "$BUILDER_REPO" --json status,conclusion)" \
        && status="$(jq -er '.status | strings | select(length > 0)' <<<"$result")" \
        && conclusion="$(jq -r '.conclusion // empty' <<<"$result")"; then
      errors=0
      echo "bake status: $status${conclusion:+ ($conclusion)}"
      if [[ "$status" == completed ]]; then
        if [[ "$conclusion" == success ]]; then
          echo "bake succeeded"
          return 0
        fi
        if [[ -n "$conclusion" ]]; then
          warn "bake completed with conclusion: $conclusion"
          return 1
        fi
        # A completed run without a conclusion is not proof of success or failure.
        warn "bake conclusion not available yet; retrying"
      fi
    else
      errors=$((errors + 1))
      warn "could not read bake status ($errors/10 consecutive errors); this does not mean the bake failed"
      if (( errors >= 10 )); then
        break
      fi
    fi
    sleep 30
  done
  warn "bake outcome unknown: monitoring stopped after repeated API errors or the one-hour limit"
  warn "monitoring did not cancel the workflow; resume with: ./poc watch-bake $id"
  return 2
}

run_bake() {
  local start id
  start="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # Never retry dispatch: a lost response could still have created a run.
  gh workflow run bake.yml -R "$BUILDER_REPO" --ref main || {
    warn "bake dispatch could not be confirmed; check https://github.com/$BUILDER_REPO/actions before retrying"
    return 2
  }
  for _ in $(seq 1 30); do
    if id="$(gh run list -R "$BUILDER_REPO" --workflow bake.yml --event workflow_dispatch -L 5 \
      --json databaseId,createdAt -q "[.[] | select(.createdAt >= \"$start\")][0].databaseId // empty")"; then
      [[ -n "$id" ]] && break
    else
      warn "could not discover bake run; retrying without dispatching again"
    fi
    sleep 5
  done
  if [[ -z "${id:-}" ]]; then
    warn "bake run not identified; outcome unknown. Find it at https://github.com/$BUILDER_REPO/actions, then use ./poc watch-bake <run-id>"
    return 2
  fi
  watch_bake "$id" || return $?
  aws ec2 describe-images --owners self \
    --filters Name=tag:cf:managed,Values=true Name=tag:cf:os,Values=ubuntu \
    --query 'sort_by(Images,&CreationDate)[-1].[ImageId,Name]' --output text
  az sig image-version list -g cf-images -r cfimages -i ubuntu --query "[-1].name" -o tsv | sed 's/^/azure cfimages\/ubuntu /'
}

# The catalog keeps entities in Postgres across redeploys; re-read every location now so changes to
# org.yaml (new users/teams) take effect immediately instead of on the next processing cycle.
refresh_catalog_locations() {
  local token n
  token="$(tf_infra output -raw backstage_token)"
  for n in $(curl -s -H "Authorization: Bearer $token" "https://$DOMAIN/api/catalog/entities?filter=kind=location" \
               | jq -r '.[].metadata.name' 2>/dev/null); do
    curl -s -o /dev/null -X POST -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
      -d "{\"entityRef\":\"location:default/$n\"}" "https://$DOMAIN/api/catalog/refresh" || true
  done
  echo "catalog locations refreshed"
}

deploy_idp() (
  local ip="$1" mode="$2" image="${3:-}" env_file start deadline
  env_file=$(mktemp "$GEN/idp.env.XXXXXX")
  trap 'rm -f "$env_file"' EXIT
  if [[ "$mode" == bootstrap ]]; then
    wait_for_ssh_ready "$ip"
    echo "host ready"
    dns_apply "$ip"
    echo "dns: $DOMAIN -> $ip"
    restore_caddy_data "$ip"
  fi
  start=$SECONDS
  write_idp_env "$env_file"
  echo "Prepare IDP configuration: $((SECONDS - start))s"
  if [[ -n "$image" ]]; then
    "$IDP_DIR/deploy/deploy.sh" "$ip" "$env_file" "$image"
  else
    "$IDP_DIR/deploy/deploy.sh" "$ip" "$env_file"
  fi
  start=$SECONDS
  deadline=$((SECONDS + 600))
  echo "waiting for $HEALTH_URL"
  while (( SECONDS < deadline )); do
    if [[ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$HEALTH_URL" || true)" == "200" ]]; then
      echo "IDP healthy"
      echo "Wait for readiness: $((SECONDS - start))s"
      start=$SECONDS
      refresh_catalog_locations
      echo "Refresh catalog: $((SECONDS - start))s"
      return 0
    fi
    sleep 2
  done
  echo "IDP not healthy after 10 min" >&2
  return 1
)

existing_idp_ip() {
  local ip
  ip="$(infra_out idp_ip)"
  [[ -n "$ip" ]] || die "no IDP host in local infra state; run ./poc up first"
  printf '%s\n' "$ip"
}

cmd_deploy_idp() {
  [[ $# -le 1 ]] || die "usage: ./poc deploy-idp [<sha256:image-id>]"
  if [[ $# -eq 1 && ! "$1" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    die "pass the full image ID printed by compute-factory-idp/deploy/build.sh"
  fi
  local tool ip
  for tool in terraform docker curl jq ssh scp; do
    command -v "$tool" >/dev/null || die "missing tool: $tool"
  done
  [[ -s "$USERS_FILE" ]] || die "no IDP users; run ./poc set-password <user> first"
  [[ -s "$ROOT/.poc.env" ]] || die "missing $ROOT/.poc.env"
  ip="$(existing_idp_ip)"
  deploy_idp "$ip" routine "${1:-}"
}

cmd_prune_idp_images() {
  [[ $# -eq 0 ]] || die "usage: ./poc prune-idp-images"
  local ip
  ip="$(existing_idp_ip)"
  "$IDP_DIR/deploy/deploy.sh" --prune "$ip"
}

cmd_up() {
  acquire_poc_lock
  log "Preflight"
  require_tools docker
  require_terraform_azure_auth
  [[ -f "$ROOT/.poc.env" ]] || die "missing $ROOT/.poc.env (copy poc.env.example and fill it in)"
  # shellcheck disable=SC1091
  ( set -a; source "$ROOT/.poc.env"; : "${GITHUB_TOKEN:?}" ) || die ".poc.env must set GITHUB_TOKEN"
  [[ -s "$USERS_FILE" ]] || die "no IDP users; run ./poc set-password <user> first"
  # One-time Azure setup that survives down (DESIGN.md section 9).
  [[ -s "$ROOT/.poc-azure-reader.pem" ]] || die "missing $ROOT/.poc-azure-reader.pem (IDP Azure reader certificate; DESIGN.md section 9)"
  local repo var
  for repo in "$BUILDER_REPO" "$PLATFORM_REPO"; do
    for var in AZURE_CLIENT_ID AZURE_TENANT_ID AZURE_SUBSCRIPTION_ID AZURE_LOCATION; do
      gh variable get "$var" -R "$repo" >/dev/null 2>&1 || die "$repo has no $var variable (one-time Azure setup; DESIGN.md section 9)"
    done
  done
  ensure_repos
  terraform -chdir="$INFRA_DIR" init -input=false >/dev/null
  if infra_has_state && [[ "${POC_FORCE_UP:-}" != "1" ]]; then
    die "infra state already exists - run ./poc down first (or POC_FORCE_UP=1 to converge in place)"
  fi

  log "Shared AWS infra (state bucket, SSH CA, IDP host, tokens)"
  tf_infra apply -auto-approve -input=false >"$GEN/logs/infra-apply.log" 2>&1 \
    || { tail -40 "$GEN/logs/infra-apply.log" >&2; die "infra apply failed"; }
  local ip bucket
  ip="$(infra_out idp_ip)"; bucket="$(infra_out state_bucket)"
  info "IDP host $ip, state bucket $bucket"

  log "GitHub wiring"
  gh variable set TF_STATE_BUCKET -R "$PLATFORM_REPO" -b "$bucket"
  gh variable set BACKSTAGE_URL -R "$PLATFORM_REPO" -b "https://$DOMAIN"
  tf_infra output -raw backstage_token | gh secret set BACKSTAGE_TOKEN -R "$PLATFORM_REPO"
  reset_inventory

  log "Clear maintenance gate"
  set_maintenance_gate 0
  log "Enable resource workflows"
  workflow_action enable

  log "Bake golden image + deploy IDP (in parallel)"
  run_bake   >"$GEN/logs/bake.log" 2>&1 & local bake_pid=$!
  deploy_idp "$ip" bootstrap >"$GEN/logs/idp.log" 2>&1 & local idp_pid=$!
  info "logs: $GEN/logs/bake.log, $GEN/logs/idp.log"
  local rc=0
  local bake_rc=0
  wait "$bake_pid" || bake_rc=$?
  if (( bake_rc != 0 )); then
    if (( bake_rc == 2 )); then
      warn "bake outcome could not be verified:"
    else
      warn "bake or image lookup failed:"
    fi
    tail -20 "$GEN/logs/bake.log" >&2
    rc=1
  fi
  wait "$idp_pid"  || { warn "IDP deploy failed:"; tail -30 "$GEN/logs/idp.log" >&2; rc=1; }
  [[ $rc -eq 0 ]] || die "up did not complete successfully; resources are left in place. Check ./poc status and the logs above. Only run ./poc down if you intend to destroy the POC and all requested VMs."

  log "Up"
  info "IDP:          https://$DOMAIN"
  info "Golden image: $(tail -1 "$GEN/logs/bake.log")"
  info "IDP host:     ssh ubuntu@$ip"
}

# ---------------------------------------------------------------- down

workflow_action() {
  local action="$1" spec repo workflow state
  for spec in "${WORKFLOW_SPECS[@]}"; do
    repo="${spec%%:*}"
    workflow="${spec#*:}"
    state="$(gh workflow list --all -R "$repo" --json path,state \
      --jq ".[] | select(.path == \".github/workflows/$workflow\") | .state")" \
      || die "could not inspect $repo/$workflow; refusing to continue"
    [[ -n "$state" ]] || die "$repo/$workflow was not found; refusing to continue"
    if [[ "$action" == disable && "$state" != active ]]; then
      info "$repo/$workflow already disabled ($state)"
      continue
    fi
    if [[ "$action" == enable && "$state" == active ]]; then
      info "$repo/$workflow already enabled"
      continue
    fi
    gh workflow "$action" "$workflow" -R "$repo" >/dev/null \
      || die "could not $action $repo/$workflow; refusing to continue"
    info "$action $repo/$workflow"
  done
}

verify_workflows_disabled() {
  local spec repo workflow state
  for spec in "${WORKFLOW_SPECS[@]}"; do
    repo="${spec%%:*}"
    workflow="${spec#*:}"
    state="$(gh workflow list --all -R "$repo" --json path,state \
      --jq ".[] | select(.path == \".github/workflows/$workflow\") | .state")" \
      || { warn "could not inspect $repo/$workflow"; return 1; }
    [[ -n "$state" ]] \
      || { warn "$repo/$workflow was not found"; return 1; }
    [[ "$state" != active ]] \
      || { warn "$repo/$workflow is active during teardown"; return 1; }
  done
}

list_active_runs() {
  local repo="$1"
  gh api --paginate "repos/$repo/actions/runs?per_page=100" \
    --jq '.workflow_runs[] | select(.status != "completed") | .id'
}

active_runs() {
  local repo
  for repo in "$PLATFORM_REPO" "$BUILDER_REPO"; do
    list_active_runs "$repo" | awk -v repo="$repo" '{print repo ":" $0}' \
      || return 1
  done
}

cancel_runs() {
  local repo ids id active deadline
  for repo in "$PLATFORM_REPO" "$BUILDER_REPO"; do
    ids="$(list_active_runs "$repo")" || die "could not enumerate active runs in $repo; refusing to continue"
    for id in $ids; do
      gh run cancel "$id" -R "$repo" >/dev/null 2>&1 \
        && info "cancelled $repo run $id" \
        || warn "run $repo/$id was not cancellable; it must disappear before teardown continues"
    done
  done

  # A cancelled workflow can still be cleaning up its runner. Never sweep cloud resources
  # while any resource-creating workflow is still active.
  deadline=$((SECONDS + RUN_CANCEL_TIMEOUT))
  while (( SECONDS < deadline )); do
    active="$(active_runs)" || die "could not verify workflow quiescence; refusing to continue"
    [[ -z "$active" ]] && return 0
    sleep 10
  done
  printf '%s\n' "$active" | sed 's/^/    /' >&2
  die "resource-creating workflows are still active after ${RUN_CANCEL_TIMEOUT}s; refusing to sweep"
}

# Caddy's TLS cert/account storage is kept on the laptop across cycles, so `up` doesn't hit
# Let's Encrypt's duplicate-certificate limit (5/week). Compose project "idp" (dir /opt/idp).
CADDY_BACKUP="$GEN/caddy-data.tgz"
CADDY_VOLUME="idp_caddy_data"

save_caddy_data() {
  local ip tmp
  ip="$(infra_out idp_ip)"
  [[ -n "$ip" ]] || return 0
  tmp="$(mktemp)"
  if ssh "${SSH_OPTS[@]}" "ubuntu@$ip" "docker run --rm -v $CADDY_VOLUME:/data:ro alpine tar cz -C /data ." >"$tmp" 2>/dev/null \
     && tar tzf "$tmp" 2>/dev/null | grep -q '\.crt$'; then
    (umask 077; mv "$tmp" "$CADDY_BACKUP") && info "saved TLS cert storage to $CADDY_BACKUP"
  else
    rm -f "$tmp"; info "no TLS cert to save (keeping any previous backup)"
  fi
}

restore_caddy_data() {
  local ip="$1"
  if ! tar tzf "$CADDY_BACKUP" 2>/dev/null | grep -q '\.crt$'; then
    echo "no valid saved TLS cert; Caddy will request one"
    return 0
  fi
  ssh "${SSH_OPTS[@]}" "ubuntu@$ip" "docker volume create \
      --label com.docker.compose.project=idp --label com.docker.compose.volume=caddy_data $CADDY_VOLUME >/dev/null \
    && docker run --rm -i -v $CADDY_VOLUME:/data alpine tar xz -C /data" <"$CADDY_BACKUP"
  echo "restored saved TLS cert storage"
}

stop_idp() {
  local ip instance_ids instance_id state result discovered
  ip="$(infra_out idp_ip)"
  if [[ -n "$ip" ]]; then
    ssh "${SSH_OPTS[@]}" "ubuntu@$ip" 'cd /opt/idp 2>/dev/null && docker compose down' >/dev/null 2>&1 \
      && info "IDP containers stopped" || warn "could not reach IDP host; stopping its EC2 instance instead"
  fi
  instance_ids="$(infra_out idp_instance_id)"
  discovered="$(aws ec2 describe-instances --filters Name=tag:Name,Values=cf-idp \
    Name=instance-state-name,Values=pending,running,stopping,stopped \
    --query 'Reservations[].Instances[].InstanceId' --output text)"
  instance_ids="$(printf '%s\n%s\n' "$instance_ids" "$discovered" | tr '\t' '\n' |
    awk 'NF && $0 != "None"' | sort -u || true)"
  [[ -n "$instance_ids" ]] || return 0
  for instance_id in $instance_ids; do
    result="$(aws ec2 describe-instances --instance-ids "$instance_id" \
      --query 'Reservations[0].Instances[0].State.Name' --output text 2>&1)" \
      || { [[ "$result" == *"InvalidInstanceID.NotFound"* ]] && continue; die "could not inspect IDP instance $instance_id"; }
    state="$result"
    case "$state" in
      stopped) ;;
      stopping)
        aws ec2 wait instance-stopped --instance-ids "$instance_id" \
          || die "IDP instance $instance_id did not stop; refusing to continue"
        ;;
      terminated) continue ;;
      pending|running)
        aws ec2 stop-instances --instance-ids "$instance_id" >/dev/null \
          || die "could not stop IDP instance $instance_id; refusing to continue"
        aws ec2 wait instance-stopped --instance-ids "$instance_id" \
          || die "IDP instance $instance_id did not stop; refusing to continue"
        ;;
      *) die "unexpected IDP instance state '$state'; refusing to continue" ;;
    esac
    info "IDP instance quiesced: $instance_id ($state)"
  done
}

# Called per VM by xargs: ./poc _destroy_vm <bucket> <platform> <name>
cmd_destroy_vm() {
  local bucket="$1" platform="$2" name="$3"
  local key="vms/$platform/$name/terraform.tfstate"
  local dir="$PLATFORM_DIR/terraform/platforms/$platform"
  [[ -d "$dir" ]] || { echo "[$name] no terraform root for platform '$platform'; leaving it to the tag sweep"; return 0; }
  export TF_DATA_DIR="$GEN/tf-vms/$platform-$name"
  aws s3 rm "s3://$bucket/$key.tflock" >/dev/null 2>&1 || true # runs are cancelled; stale locks only
  if terraform -chdir="$dir" init -input=false -reconfigure \
       -backend-config="bucket=$bucket" -backend-config="key=$key" \
       -backend-config="region=$AWS_REGION" -backend-config="use_lockfile=true" >"$GEN/logs/vm-$name.log" 2>&1 \
     && terraform -chdir="$dir" destroy -auto-approve -input=false -var "name=$name" >>"$GEN/logs/vm-$name.log" 2>&1; then
    echo "[$name] destroyed"
  else
    echo "[$name] terraform destroy failed (see $GEN/logs/vm-$name.log); the tag sweep will catch leftovers"
  fi
  rm -rf "$TF_DATA_DIR"
}

# Match an account-owned bucket by exact name. HeadBucket cannot distinguish absent from inaccessible.
find_state_bucket() {
  local bucket="$1"
  aws s3api list-buckets --prefix "$bucket" --query "Buckets[?Name=='$bucket'].Name" --output text
}

destroy_vms() {
  local bucket="$1" owned keys
  owned="$(find_state_bucket "$bucket")" || die "could not check for state bucket $bucket"
  [[ -n "$owned" ]] || { info "no state bucket; skipping"; return 0; }
  keys="$(aws s3api list-objects-v2 --bucket "$bucket" --prefix vms/ --query 'Contents[].Key' --output text \
    | tr '\t' '\n' | awk '/\/terraform\.tfstate$/')" || die "could not list VM state in $bucket"
  [[ -n "$keys" ]] || { info "no VMs"; return 0; }
  echo "$keys" | awk -F/ -v b="$bucket" '{print b, $2, $3}' \
    | xargs -n 3 -P "$PARALLEL_DESTROYS" "$0" _destroy_vm
}

# Remove everything tagged cf:poc=true that Terraform does not (or no longer) know about
# in one AWS region.
sweep_tagged_region() {
  local exclude_infra="$1" ids q ami_query snapshot_query volume_query eni_query eip_query sg_query
  q='Reservations[].Instances[]'
  [[ "$exclude_infra" == "1" ]] && q='Reservations[].Instances[?!(Tags[?Key==`cf:module`&&Value==`infra`])]'
  tagged_ids="$(aws ec2 describe-instances --filters Name=tag:cf:poc,Values=true \
    Name=instance-state-name,Values=pending,running,stopping,stopped,shutting-down \
    --query "$q.InstanceId" --output text)" || return 1
  ids="$(printf '%s\n' "$tagged_ids" | tr '\t' '\n' | awk 'NF' | sort -u)"
  if [[ -n "$ids" ]]; then
    info "terminating instances: $(echo $ids)"
    # shellcheck disable=SC2086
    aws ec2 terminate-instances --instance-ids $ids >/dev/null || return 1
    # shellcheck disable=SC2086
    aws ec2 wait instance-terminated --instance-ids $ids || return 1
  fi

  ami_query='Images[].ImageId'
  snapshot_query='Snapshots[].SnapshotId'
  volume_query='Volumes[].VolumeId'
  eni_query='NetworkInterfaces[].NetworkInterfaceId'
  eip_query='Addresses[].AllocationId'
  sg_query='SecurityGroups[].GroupId'
  if [[ "$exclude_infra" == "1" ]]; then
    ami_query='Images[?!(Tags[?Key==`cf:module`&&Value==`infra`])].ImageId'
    snapshot_query='Snapshots[?!(Tags[?Key==`cf:module`&&Value==`infra`])].SnapshotId'
    volume_query='Volumes[?!(Tags[?Key==`cf:module`&&Value==`infra`])].VolumeId'
    eni_query='NetworkInterfaces[?!(TagSet[?Key==`cf:module`&&Value==`infra`])].NetworkInterfaceId'
    eip_query='Addresses[?!(Tags[?Key==`cf:module`&&Value==`infra`])].AllocationId'
    sg_query='SecurityGroups[?!(Tags[?Key==`cf:module`&&Value==`infra`])].GroupId'
  fi

  local amis ami snap snapshots volumes enis eips sgs sg result
  amis="$(aws ec2 describe-images --owners self --filters Name=tag:cf:poc,Values=true \
    --query "$ami_query" --output text)" || return 1
  for ami in $amis; do
    snap="$(aws ec2 describe-images --image-ids "$ami" \
      --query 'Images[].BlockDeviceMappings[].Ebs.SnapshotId' --output text)" || return 1
    aws ec2 deregister-image --image-id "$ami" >/dev/null || return 1
    info "deregistered $ami"
    for s in $snap; do
      [[ "$s" == "None" ]] && continue
      aws ec2 delete-snapshot --snapshot-id "$s" >/dev/null || return 1
      info "deleted $s"
    done
  done

  snapshots="$(aws ec2 describe-snapshots --owner-ids self --filters Name=tag:cf:poc,Values=true \
    --query "$snapshot_query" --output text)" || return 1
  for s in $snapshots; do
    aws ec2 delete-snapshot --snapshot-id "$s" >/dev/null || return 1
    info "deleted $s"
  done

  volumes="$(aws ec2 describe-volumes --filters Name=tag:cf:poc,Values=true Name=status,Values=available \
    --query "$volume_query" --output text)" || return 1
  for v in $volumes; do
    aws ec2 delete-volume --volume-id "$v" >/dev/null || return 1
    info "deleted $v"
  done

  enis="$(aws ec2 describe-network-interfaces --filters Name=tag:cf:poc,Values=true Name=status,Values=available \
    --query "$eni_query" --output text)" || return 1
  for eni in $enis; do
    aws ec2 delete-network-interface --network-interface-id "$eni" >/dev/null || return 1
    info "deleted $eni"
  done

  eips="$(aws ec2 describe-addresses --filters Name=tag:cf:poc,Values=true \
    --query "$eip_query" --output text)" || return 1
  for a in $eips; do
    aws ec2 release-address --allocation-id "$a" >/dev/null || return 1
    info "released EIP $a"
  done

  sgs="$(aws ec2 describe-security-groups --filters Name=tag:cf:poc,Values=true \
    --query "$sg_query" --output text)" || return 1
  for sg in $sgs; do
    for _ in 1 2 3 4 5 6; do # ENIs of just-terminated instances take a moment to go away
      if aws ec2 delete-security-group --group-id "$sg" >/dev/null 2>&1; then
        info "deleted $sg"
        break
      fi
      sleep 10
    done
    if result="$(aws ec2 describe-security-groups --group-ids "$sg" 2>&1)"; then
      return 1
    fi
    [[ "$result" == *"InvalidGroup.NotFound"* ]] || return 1
  done
}

# The POC normally uses ap-southeast-2, but a failed/manual workflow must not strand
# tagged resources in another enabled region.
sweep_tagged() {
  local exclude_infra="$1" regions
  regions="$(aws ec2 describe-regions --all-regions \
    --query 'Regions[?OptInStatus==`opt-in-not-required` || OptInStatus==`opted-in`].RegionName' \
    --output text)" || die "could not enumerate AWS regions; refusing to sweep"
  printf '%s\n' $regions | xargs -n 1 -P "$AWS_REGION_PARALLEL" \
    "$ROOT/poc" _sweep_region "$exclude_infra" \
    || die "AWS sweep failed in at least one region; refusing to continue"
}

cmd_sweep_region() {
  local exclude_infra="$1" region="$2"
  info "sweeping AWS region $region"
  AWS_REGION="$region" AWS_DEFAULT_REGION="$region" sweep_tagged_region "$exclude_infra"
}

# Azure: every VM and Packer build has its own resource group tagged cf:poc=true; infra's is cf:module=infra.
sweep_azure() {
  local exclude_infra="$1" q groups g
  if [[ "$exclude_infra" == "1" ]]; then
    q="[?tags.\"cf:poc\"=='true' && tags.\"cf:module\"!='infra']"
  else
    q="[?tags.\"cf:poc\"=='true']"
  fi
  groups="$(az group list --query "$q.name" -o tsv)"
  for g in $groups; do
    az group delete -n "$g" --yes --no-wait || return 1
    info "deleting resource group $g"
  done
  for g in $groups; do
    az group wait -n "$g" --deleted --timeout 1800 || return 1
  done
}

# Packer publishes gallery image versions outside Terraform; an image definition cannot be deleted with them.
delete_image_versions() {
  local exists gallery definitions versions i v
  exists="$(az group exists -n cf-images -o tsv)" || die "could not check for Azure resource group cf-images"
  case "$exists" in
    false) return 0 ;;
    true) ;;
    *) die "unexpected Azure response while checking for cf-images: $exists" ;;
  esac
  gallery="$(az sig list -g cf-images --query "[?name=='cfimages'].name" -o tsv)" || die "could not check for Azure gallery cfimages"
  [[ -n "$gallery" ]] || return 0
  definitions="$(az sig image-definition list -g cf-images -r cfimages --query '[].name' -o tsv)" || die "could not list Azure gallery image definitions"
  for i in $definitions; do
    versions="$(az sig image-version list -g cf-images -r cfimages -i "$i" --query '[].name' -o tsv)" || die "could not list Azure gallery versions for $i"
    for v in $versions; do
      info "deleting Azure gallery image version $i/$v (can take several minutes)"
      az sig image-version delete -g cf-images -r cfimages -i "$i" -e "$v" || die "could not delete Azure gallery image version $i/$v"
      info "deleted Azure gallery image version $i/$v"
    done
  done
}

# Azure creates NetworkWatcherRG (untagged) with the first VNet in a region. Delete it only while it holds
# nothing but those automatic network watchers, so anything else in it is never touched.
sweep_network_watchers() {
  local exists other
  exists="$(az group exists -n NetworkWatcherRG -o tsv)" \
    || die "could not check NetworkWatcherRG; refusing to continue"
  [[ "$exists" == true ]] || return 0
  other="$(az resource list -g NetworkWatcherRG --query "[?type!='Microsoft.Network/networkWatchers'].id" -o tsv)"
  if [[ -n "$other" ]]; then
    warn "NetworkWatcherRG holds other resources; leaving it"
    return 1
  fi
  az group delete -n NetworkWatcherRG --yes && info "deleted NetworkWatcherRG (Azure's automatic network watchers)"
}

# Named singletons from infra/, in case local state was lost.
sweep_infra_orphans() {
  local bucket="cf-tfstate-134584031874-apse2" ids sg a
  aws s3api head-bucket --bucket "$bucket" >/dev/null 2>&1 && aws s3 rb "s3://$bucket" --force >/dev/null && info "deleted bucket $bucket"
  aws secretsmanager describe-secret --secret-id compute-factory/ssh-ca >/dev/null 2>&1 \
    && aws secretsmanager delete-secret --secret-id compute-factory/ssh-ca --force-delete-without-recovery >/dev/null && info "deleted CA secret"
  aws ssm delete-parameter --name /compute-factory/ssh-ca-pub >/dev/null 2>&1 && info "deleted CA public key parameter" || true
  aws secretsmanager describe-secret --secret-id compute-factory/azure-reader >/dev/null 2>&1 \
    && aws secretsmanager delete-secret --secret-id compute-factory/azure-reader --force-delete-without-recovery >/dev/null && info "deleted Azure reader secret"
  # These exact names are owned by this POC. The fallback catches a partial apply that
  # created a singleton before tags/state were recorded.
  ids="$(aws ec2 describe-instances --filters Name=tag:Name,Values=cf-idp \
    Name=instance-state-name,Values=pending,running,stopping,stopped \
    --query 'Reservations[].Instances[].InstanceId' --output text)"
  if [[ -n "$ids" ]]; then
    info "terminating named IDP instance(s): $ids"
    # shellcheck disable=SC2086
    aws ec2 terminate-instances --instance-ids $ids >/dev/null
    # shellcheck disable=SC2086
    aws ec2 wait instance-terminated --instance-ids $ids
  fi
  for a in $(aws ec2 describe-addresses --query \
    'Addresses[?Tags[?Key==`Name`&&Value==`cf-idp`]].AllocationId' --output text); do
    aws ec2 release-address --allocation-id "$a" >/dev/null 2>&1 && info "released named IDP EIP $a" || true
  done
  for sg in $(aws ec2 describe-security-groups --filters Name=group-name,Values=cf-idp \
    --query 'SecurityGroups[].GroupId' --output text); do
    for _ in 1 2 3 4 5 6; do
      aws ec2 delete-security-group --group-id "$sg" >/dev/null 2>&1 && { info "deleted named IDP security group $sg"; break; }
      sleep 10
    done
  done
  for a in $(aws ec2 describe-addresses --filters Name=tag:cf:poc,Values=true --query 'Addresses[].AllocationId' --output text); do
    aws ec2 release-address --allocation-id "$a" >/dev/null && info "released EIP $a"
  done
  aws ec2 delete-key-pair --key-name cf-idp-admin >/dev/null 2>&1 || true
  if aws iam get-instance-profile --instance-profile-name cf-idp >/dev/null 2>&1; then
    aws iam remove-role-from-instance-profile --instance-profile-name cf-idp --role-name cf-idp >/dev/null 2>&1 || true
    aws iam delete-instance-profile --instance-profile-name cf-idp >/dev/null && info "deleted instance profile cf-idp"
  fi
  if aws iam get-role --role-name cf-idp >/dev/null 2>&1; then
    for p in $(aws iam list-role-policies --role-name cf-idp --query 'PolicyNames' --output text); do
      aws iam delete-role-policy --role-name cf-idp --policy-name "$p"
    done
    for p in $(aws iam list-attached-role-policies --role-name cf-idp --query 'AttachedPolicies[].PolicyArn' --output text); do
      aws iam detach-role-policy --role-name cf-idp --policy-arn "$p"
    done
    aws iam delete-role --role-name cf-idp && info "deleted role cf-idp"
  fi
}

# List queries must succeed and return no matches. Point lookups must return their specific
# not-found error; permission, credential, and network failures are not evidence of absence.
verify_absent() {
  local label="$1" not_found="$2" result
  shift 2
  if result="$("$@" 2>&1)"; then
    [[ -z "$result" ]] && return 0
    warn "$label still present (or lookup returned unexpected output): $result"
  elif [[ -n "$not_found" && "$result" == *"An error occurred ($not_found) when calling the "* ]]; then
    return 0
  else
    warn "could not verify $label: $result"
  fi
  return 1
}

verify_dns_absent() {
  local reply
  if ! reply="$(dig @1.1.1.1 "$DOMAIN" A +noall +comments +answer +time=3 +tries=1 2>&1)"; then
    warn "could not verify DNS for $DOMAIN: $reply"
  elif [[ "$reply" != *"status: NOERROR,"* && "$reply" != *"status: NXDOMAIN,"* ]]; then
    warn "could not verify DNS for $DOMAIN: $reply"
  elif [[ "$reply" != *"ANSWER: 0,"* ]]; then
    warn "DNS $DOMAIN still resolves (may be cached; TTL 60s)"
  else
    return 0
  fi
  return 1
}

verify_aws_region() {
  local region="$1" tagged
  verify_absent "AWS $region instances" "" aws ec2 describe-instances \
    --filters Name=tag:cf:poc,Values=true Name=instance-state-name,Values=pending,running,stopping,stopped,shutting-down \
    --query 'Reservations[].Instances[].InstanceId' --output text || return 1
  verify_absent "AWS $region named cf-idp instances" "" aws ec2 describe-instances \
    --filters Name=tag:Name,Values=cf-idp Name=instance-state-name,Values=pending,running,stopping,stopped,shutting-down \
    --query 'Reservations[].Instances[].InstanceId' --output text || return 1
  verify_absent "AWS $region packer instances" "" aws ec2 describe-instances \
    --filters Name=key-name,Values=packer_* Name=instance-state-name,Values=pending,running,stopping,stopped,shutting-down \
    --query 'Reservations[].Instances[].InstanceId' --output text || return 1
  verify_absent "AWS $region AMIs" "" aws ec2 describe-images --owners self \
    --filters Name=tag:cf:poc,Values=true --query 'Images[].ImageId' --output text || return 1
  verify_absent "AWS $region snapshots" "" aws ec2 describe-snapshots --owner-ids self \
    --filters Name=tag:cf:poc,Values=true --query 'Snapshots[].SnapshotId' --output text || return 1
  verify_absent "AWS $region volumes" "" aws ec2 describe-volumes \
    --filters Name=tag:cf:poc,Values=true --query 'Volumes[].VolumeId' --output text || return 1
  verify_absent "AWS $region network interfaces" "" aws ec2 describe-network-interfaces \
    --filters Name=tag:cf:poc,Values=true --query 'NetworkInterfaces[].NetworkInterfaceId' --output text || return 1
  verify_absent "AWS $region security groups" "" aws ec2 describe-security-groups \
    --filters Name=tag:cf:poc,Values=true --query 'SecurityGroups[].GroupId' --output text || return 1
  verify_absent "AWS $region named cf-idp security group" "" aws ec2 describe-security-groups \
    --filters Name=group-name,Values=cf-idp --query 'SecurityGroups[].GroupId' --output text || return 1
  verify_absent "AWS $region packer security groups" "" aws ec2 describe-security-groups \
    --filters Name=group-name,Values=packer_* --query 'SecurityGroups[].GroupId' --output text || return 1
  verify_absent "AWS $region EIPs" "" aws ec2 describe-addresses \
    --filters Name=tag:cf:poc,Values=true --query 'Addresses[].PublicIp' --output text || return 1
  verify_absent "AWS $region named cf-idp EIPs" "" aws ec2 describe-addresses \
    --query 'Addresses[?Tags[?Key==`Name`&&Value==`cf-idp`]].AllocationId' --output text || return 1
  verify_absent "AWS $region packer key pairs" "" aws ec2 describe-key-pairs \
    --filters 'Name=key-name,Values=packer_*' --query 'KeyPairs[].KeyName' --output text || return 1
  verify_absent "AWS $region named cf-idp-admin key pair" InvalidKeyPair.NotFound \
    aws ec2 describe-key-pairs --key-names cf-idp-admin --query 'KeyPairs[].KeyName' --output text || return 1
  tagged="$(aws resourcegroupstaggingapi get-resources --tag-filters Key=cf:poc,Values=true \
    --query 'ResourceTagMappingList[].ResourceARN' --output text)" || return 1
  if [[ -n "$tagged" ]]; then
    warn "AWS $region tagging API still reports POC resources:"
    printf '%s\n' "$tagged" | tr '\t' '\n' | sed 's/^/      /' >&2
    return 1
  fi
}

verify_aws_regions() {
  local regions
  regions="$(aws ec2 describe-regions --all-regions \
    --query 'Regions[?OptInStatus==`opt-in-not-required` || OptInStatus==`opted-in`].RegionName' \
    --output text)" || return 1
  printf '%s\n' $regions | xargs -n 1 -P "$AWS_REGION_PARALLEL" \
    "$ROOT/poc" _verify_region
}

cmd_verify_region() {
  local region="$1"
  AWS_REGION="$region" AWS_DEFAULT_REGION="$region" verify_aws_region "$region"
}

verify_clean_once() {
  local bucket="$1" failed=0 active
  verify_maintenance_gate || failed=1
  verify_workflows_disabled || failed=1
  active="$(active_runs)" || { warn "could not verify workflow quiescence"; return 1; }
  if [[ -n "$active" ]]; then
    warn "active resource-creating workflows remain:"
    printf '%s\n' "$active" | sed 's/^/      /' >&2
    failed=1
  fi
  verify_aws_regions || failed=1

  AWS_REGION="$POC_AWS_REGION" AWS_DEFAULT_REGION="$POC_AWS_REGION" \
    verify_absent "state bucket" "" find_state_bucket "$bucket" || failed=1
  AWS_REGION="$POC_AWS_REGION" AWS_DEFAULT_REGION="$POC_AWS_REGION" \
    verify_absent "CA secret" ResourceNotFoundException aws secretsmanager describe-secret \
      --secret-id compute-factory/ssh-ca --query ARN --output text || failed=1
  AWS_REGION="$POC_AWS_REGION" AWS_DEFAULT_REGION="$POC_AWS_REGION" \
    verify_absent "CA public key parameter" ParameterNotFound aws ssm get-parameter \
      --name /compute-factory/ssh-ca-pub --query Parameter.Name --output text || failed=1
  verify_absent "IAM role cf-idp" NoSuchEntity aws iam get-role \
    --role-name cf-idp --query Role.RoleName --output text || failed=1
  verify_absent "IAM instance profile cf-idp" NoSuchEntity aws iam get-instance-profile \
    --instance-profile-name cf-idp --query InstanceProfile.InstanceProfileName --output text || failed=1
  AWS_REGION="$POC_AWS_REGION" AWS_DEFAULT_REGION="$POC_AWS_REGION" \
    verify_absent "Azure reader secret" ResourceNotFoundException aws secretsmanager describe-secret \
      --secret-id compute-factory/azure-reader --query ARN --output text || failed=1
  verify_absent "Azure resource groups" "" az group list --query '[].name' -o tsv || failed=1
  verify_absent "Azure tagged resources" "" az resource list \
    --tag 'cf:poc=true' --query '[].id' -o tsv || failed=1
  verify_dns_absent || failed=1
  [[ "$failed" == 0 ]]
}

verify_clean() {
  local bucket="$1" pass
  for pass in $(seq 1 "$CLEAN_STABILITY_PASSES"); do
    log "Verify pass $pass/$CLEAN_STABILITY_PASSES"
    if ! verify_clean_once "$bucket"; then
      printf '\n\033[31mNOT CLEAN: resources remain, workflows are active, or a required check failed.\033[0m\n'
      return 1
    fi
    [[ "$pass" == "$CLEAN_STABILITY_PASSES" ]] || sleep "$CLEAN_STABILITY_SECONDS"
  done
  printf '\n\033[32mCLEAN: no Compute Factory resources found across enabled regions and stable verification passes.\033[0m\n'
}

cmd_down() {
  acquire_poc_lock
  log "Preflight"
  require_tools dig
  terraform -chdir="$INFRA_DIR" init -input=false >/dev/null
  local bucket
  bucket="$(infra_out state_bucket)"; bucket="${bucket:-cf-tfstate-134584031874-apse2}"

  log "Freeze: stop IDP and gate resource workflows"
  save_caddy_data
  set_maintenance_gate 1
  stop_idp
  workflow_action disable
  cancel_runs

  log "Destroy user VMs (Terraform, $PARALLEL_DESTROYS in parallel)"
  [[ -d "$PLATFORM_DIR/.git" ]] || git clone -q "git@github.com:$PLATFORM_REPO.git" "$PLATFORM_DIR"
  destroy_vms "$bucket"

  log "Sweep leftovers tagged cf:poc=true (VMs, AMIs, snapshots, Packer temp resources; AWS and Azure)"
  sweep_tagged 1
  sweep_azure 1
  delete_image_versions

  log "DNS: remove $DOMAIN"
  dns_apply "" && info "removed" || warn "DNS removal failed (see $GEN/logs/dns.log)"

  log "Destroy shared infra"
  if infra_has_state; then
    tf_infra destroy -auto-approve -input=false >"$GEN/logs/infra-destroy.log" 2>&1 \
      && info "infra destroyed" || { tail -30 "$GEN/logs/infra-destroy.log" >&2; warn "infra destroy failed; sweeping by name"; }
  else
    info "no infra state"
  fi
  sweep_infra_orphans
  sweep_tagged 0
  sweep_azure 0
  sweep_network_watchers

  log "GitHub cleanup"
  gh variable delete TF_STATE_BUCKET -R "$PLATFORM_REPO" >/dev/null 2>&1 || true
  gh variable delete BACKSTAGE_URL -R "$PLATFORM_REPO" >/dev/null 2>&1 || true
  gh secret delete BACKSTAGE_TOKEN -R "$PLATFORM_REPO" >/dev/null 2>&1 || true
  reset_inventory
  rm -rf "$GEN/idp.env" "$GEN/tf-vms"

  log "Verify"
  verify_clean "$bucket"
}

# ---------------------------------------------------------------- users

# ./poc set-password <user>: add or change an IDP login. The user also needs an entry in the idp repo's
# catalog/org.yaml. Takes effect on the next deploy (./poc up or ./poc deploy-idp).
cmd_set_password() {
  local user="${1:-}" pw pw2 hash
  [[ "$user" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || die "usage: $0 set-password <username>"
  [[ -f "$IDP_DIR/deploy/hash-password.mjs" ]] || die "missing $IDP_DIR/deploy/hash-password.mjs"
  read -rsp "Password for $user: " pw; echo
  read -rsp "Repeat: " pw2; echo
  [[ "$pw" == "$pw2" ]] || die "passwords don't match"
  [[ ${#pw} -ge 8 ]] || die "use at least 8 characters"
  hash="$(printf '%s' "$pw" | (cd "$IDP_DIR" && mise exec -- node deploy/hash-password.mjs))"
  [[ -n "$hash" && "$hash" != *$'\n'* ]] || die "hashing failed"
  umask 077
  touch "$USERS_FILE"
  { grep -v "^$user:" "$USERS_FILE" || true; printf '%s:%s\n' "$user" "$hash"; } >"$USERS_FILE.tmp"
  mv "$USERS_FILE.tmp" "$USERS_FILE"
  touch "$PASSWORDS_FILE"
  { grep -v "^$user:" "$PASSWORDS_FILE" || true; printf '%s:%s\n' "$user" "$pw"; } >"$PASSWORDS_FILE.tmp"
  mv "$PASSWORDS_FILE.tmp" "$PASSWORDS_FILE"
  info "password set for $user (plaintext kept in .poc-passwords); deploy with ./poc deploy-idp"
}

# ---------------------------------------------------------------- status

cmd_status() {
  require_tools
  terraform -chdir="$INFRA_DIR" init -input=false >/dev/null
  log "Shared infra"
  if infra_has_state; then
    info "IDP host:     $(infra_out idp_ip) ($(infra_out idp_instance_id))"
    info "State bucket: $(infra_out state_bucket)"
    local code
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "$HEALTH_URL" || true)"
    info "IDP health:   $([[ "$code" == 000 || -z "$code" ]] && echo unreachable || echo "HTTP $code")"
  else
    info "none"
  fi
  log "Golden images"
  aws ec2 describe-images --owners self --filters Name=tag:cf:poc,Values=true \
    --query 'Images[].[ImageId,Name,CreationDate]' --output text | sed 's/^/    /'
  log "Instances tagged cf:poc=true"
  aws ec2 describe-instances --filters Name=tag:cf:poc,Values=true Name=instance-state-name,Values=pending,running,stopping,stopped \
    --query 'Reservations[].Instances[].[InstanceId,State.Name,PublicIpAddress,Tags[?Key==`Name`]|[0].Value]' --output text | sed 's/^/    /'
  log "Azure resource groups tagged cf:poc=true"
  az group list --query "[?tags.\"cf:poc\"=='true'].[name,properties.provisioningState]" -o tsv | sed 's/^/    /'
  log "Azure golden images"
  local def
  for def in $(az sig image-definition list -g cf-images -r cfimages --query '[].name' -o tsv 2>/dev/null); do
    az sig image-version list -g cf-images -r cfimages -i "$def" --query '[].[name,provisioningState]' -o tsv | sed "s/^/    $def /"
  done
  log "VM state files"
  aws s3 ls "s3://cf-tfstate-134584031874-apse2/vms/" --recursive 2>/dev/null | sed 's/^/    /' || info "no bucket"
  log "Active pipeline runs"
  local repo
  for repo in "$PLATFORM_REPO" "$BUILDER_REPO"; do
    gh run list -R "$repo" -L 20 --json databaseId,status,displayTitle \
      -q '.[] | select(.status != "completed") | "    \(.databaseId) \(.status) \(.displayTitle)"' 2>/dev/null || true
  done
}

idp_host() {
  local ip
  ip="$(infra_out idp_ip)"
  [[ -n "$ip" ]] || die "no IDP host (run ./poc up)"
  echo "ubuntu@$ip"
}

# Read-only. Pipe to grep/jq locally, e.g. ./poc logs caddy 10m | grep /events
cmd_logs() {
  local service="${1:-backstage}" since="${2:-30m}"
  [[ "$service" =~ ^(backstage|caddy|postgres|all)$ ]] || die "service must be backstage, caddy, postgres or all"
  [[ "$since" =~ ^[0-9]+[smh]$ ]] || die "since must look like 30m, 2h or 90s"
  [[ "$service" == all ]] && service=""
  local host; host="$(idp_host)"
  ssh "${SSH_OPTS[@]}" "$host" "cd /opt/idp && docker compose logs --no-color --no-log-prefix --since $since $service" </dev/null
}

# Read-only. If the task page is blank but events exist here, the problem is delivery to the browser.
cmd_task() {
  local id="${1:-}"
  [[ "$id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || die "usage: $0 task <task-uuid>"
  local host; host="$(idp_host)"
  ssh "${SSH_OPTS[@]}" "$host" "cd /opt/idp && docker compose exec -T postgres psql -U backstage -d backstage_plugin_scaffolder \
    -c \"select status, created_at, last_heartbeat_at, created_by from tasks where id = '$id'\" \
    -c \"select id, event_type, created_at, left(body::text, 300) as body from task_events where task_id = '$id' order by id\"" </dev/null
}

# Read-only. Orchestrator state of one VM run (the IDP run page shows the same data).
cmd_run() {
  local id="${1:-}"
  [[ "$id" =~ ^[1-9][0-9]{0,9}$ ]] || die "usage: $0 run <run-id>"
  local host; host="$(idp_host)"
  ssh "${SSH_OPTS[@]}" "$host" "cd /opt/idp && docker compose exec -T postgres psql -U backstage -d backstage_plugin_vms \
    -c \"select id, kind, name, team, status, requested_by, to_timestamp(created_at/1000) as created, left(error, 200) as error from vm_runs where id = $id\" \
    -c \"select stage, status, attempt, max_attempts + budget_start as max, gha_run_id, conclusion, to_timestamp(next_attempt_at/1000) as next_attempt, left(error, 160) as error from vm_run_stages where run_id = $id order by position\"" </dev/null
}

case "${1:-}" in
  up)          cmd_up ;;
  logs)        shift; cmd_logs "$@" ;;
  task)        shift; cmd_task "$@" ;;
  run)         shift; cmd_run "$@" ;;
  down)        cmd_down ;;
  status)      cmd_status ;;
  watch-bake)  command -v gh >/dev/null || die "missing tool: gh"
               command -v jq >/dev/null || die "missing tool: jq"
               watch_bake "${2:-}" ;;
  set-password) shift; cmd_set_password "$@" ;;
  deploy-idp)  shift; cmd_deploy_idp "$@" ;;
  prune-idp-images) shift; cmd_prune_idp_images "$@" ;;
  _destroy_vm) shift; cmd_destroy_vm "$@" ;;
  _sweep_region) shift; cmd_sweep_region "$@" ;;
  _verify_region) shift; cmd_verify_region "$@" ;;
  *) echo "usage: $0 up|down|status|deploy-idp [<image-id>]|prune-idp-images|set-password <user>|watch-bake <run-id>|logs [service] [since]|task <task-id>|run <run-id>" >&2; exit 2 ;;
esac
