#!/usr/bin/env python3
"""Vendy POC lifecycle. The implementation is in pocctl/; see DESIGN.md section 12.

  ./poc up                      create everything (assumes a clean slate apart from a kept SSH CA + golden images)
  ./poc up --resume <run-id>    finish bootstrap on existing infra using one dispatched bake (running or succeeded)
  ./poc up --images-only        create the SSH CA/gallery if missing, bake every images.yaml row, prune old images
  ./poc down                    destroy everything, including user VMs, then verify nothing tagged cf:poc=true remains
  ./poc down --keep-images      the same, but keep the SSH CA and golden images (infra/images) for the next up
  ./poc status                  read-only overview
  ./poc deploy-idp [<image-id>] deploy to the existing host, building only when no artifact is supplied
  ./poc prune-idp-images        explicitly collect old IDP registry blobs and dangling IDP images
  ./poc watch-bake <run-id>     monitor an existing bake without dispatching another
  ./poc set-password <user>     add/change an IDP login (hash stored in .poc-users)
  ./poc logs [backstage|caddy|postgres|all] [since]   IDP container logs (default: backstage, 30m)
  ./poc task <task-id>          Scaffolder task status and stored events, straight from Postgres
  ./poc run <run-id>            VM orchestrator run and stage state, straight from Postgres
"""

import os
import sys

if sys.version_info < (3, 10):
    sys.exit("./poc needs Python 3.10 or newer")
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from pocctl.cli import main

sys.exit(main(sys.argv[1:]))
