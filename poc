  terraform -chdir="$CF_DNS_DIR" apply -auto-approve -input=false \
    -target=cloudflare_dns_record.idp -var "idp_ip=$1" >"$GEN/logs/dns.log" 2>&1 \
    || { cat "$GEN/logs/dns.log" >&2; return 1; }
}

write_idp_env() {
  local file=$1 github_token users postgres token ca reader
  # shellcheck disable=SC1091
  github_token="$(source "$ROOT/.poc.env" && printf '%s' "${GITHUB_TOKEN:?}")" || return 1
  users="$(base64 <"$USERS_FILE" | tr -d '\n')" || return 1
  postgres="$(tf_infra output -raw postgres_password)" || return 1
  token="$(tf_infra output -raw backstage_token)" || return 1
  ca="$(tf_infra output -raw ssh_ca_secret_id)" || return 1
  reader="$(tf_infra output -raw azure_reader_secret_id)" || return 1
  [[ -n "$github_token" && -n "$users" && -n "$postgres" && -n "$token" && -n "$ca" && -n "$reader" ]] \
    || die "IDP configuration has missing required values"
  umask 077
  cat >"$file" <<EOF
IDP_DOMAIN=$DOMAIN
IDP_USERS_B64=$users
GITHUB_TOKEN=$github_token
POSTGRES_PASSWORD=$postgres
BACKSTAGE_TOKEN=$token
AWS_REGION=$AWS_REGION
SSH_CA_SECRET_ID=$ca
AZURE_READER_SECRET_ID=$reader
EOF
}

watch_bake() {
  local id="${1:-}" result status conclusion errors=0 deadline=$((SECONDS + 3600))
  [[ "$id" =~ ^[1-9][0-9]*$ ]] || die "usage: $0 watch-bake <run-id>"
  echo "bake run: https://github.com/$BUILDER_REPO/actions/runs/$id"
  while (( SECONDS < deadline )); do
    if result="$(gh run view "$id" -R "$BUILDER_REPO" --json status,conclusion)" \
        && status="$(jq -er '.status | strings | select(length > 0)' <<<"$result")" \
        && conclusion="$(jq -r '.conclusion // empty' <<<"$result")"; then
      errors=0
      echo "bake status: $status${conclusion:+ ($conclusion)}"
      if [[ "$status" == completed ]]; then
        if [[ "$conclusion" == success ]]; then
          echo "bake succeeded"
          return 0
        fi
        if [[ -n "$conclusion" ]]; then
          warn "bake completed with conclusion: $conclusion"
          return 1
        fi
        # A completed run without a conclusion is not proof of success or failure.
        warn "bake conclusion not available yet; retrying"
      fi
    else
      errors=$((errors + 1))
      warn "could not read bake status ($errors/10 consecutive errors); this does not mean the bake failed"
      if (( errors >= 10 )); then
        break
      fi
    fi
    sleep 30
  done
  warn "bake outcome unknown: monitoring stopped after repeated API errors or the one-hour limit"
  warn "monitoring did not cancel the workflow; resume with: ./poc watch-bake $id"
  return 2
}

run_bake() {
  local fp="$1" id response
  # Never retry dispatch: a lost response could still have created a run.
  if ! response="$(gh api "repos/$BUILDER_REPO/actions/workflows/bake.yml/dispatches" \
        -f ref=main -F return_run_details=true)"; then
    warn "bake dispatch could not be confirmed; check https://github.com/$BUILDER_REPO/actions before retrying"
    return 2
  fi
  if ! id="$(jq -er '.workflow_run_id | numbers | select(. > 0 and floor == .)' <<<"$response")"; then
    warn "dispatch returned no run ID; outcome unknown. Find it at https://github.com/$BUILDER_REPO/actions; never assume the latest run is yours"
    return 2
  fi
  printf '%s\n' "$id" >"$GEN/bake-run-id" || return 1
  watch_bake "$id" || return $?
  verify_bake_images "$id" "$fp"
}

download_bake_manifest() {
  local id="$1" dir="$2" name="$3" attempt_dir
  # gh may skip existing files; a partial download must not contaminate a retry.
  attempt_dir="$(mktemp -d "$dir/$name.XXXXXX")" || return 1
  gh run download "$id" -R "$BUILDER_REPO" -n "$name" -D "$attempt_dir" </dev/null >&2 || return 1
  printf '%s\n' "$attempt_dir/packer-manifest.json"
}

# Every images.yaml row of the run's commit must have produced exactly one artifact that is now the
# current usable image of its row and trusts CA $2. Only prune after every row is verified.
verify_bake_images() (
  local id="$1" fp="$2" prune="${3:-1}" tmp run sha rows os version platform name builder manifest artifact expected line deadline
  local verified=()
  tmp="$(mktemp -d "$GEN/bake.XXXXXX")" || return 1
  trap 'rm -rf "$tmp"' EXIT
  run="$(gh_read api "repos/$BUILDER_REPO/actions/runs/$id")" \
    || { warn "could not read bake run $id"; return 1; }
  sha="$(jq -er --arg repo "$BUILDER_REPO" '
    select(.path == ".github/workflows/bake.yml" and .head_repository.full_name == $repo
      and .head_branch == "main" and .event == "workflow_dispatch"
      and .status == "completed" and .conclusion == "success")
    | .head_sha | strings | select(test("^[0-9a-f]{40}$"))' <<<"$run")" \
    || { warn "run $id is not a confirmed successful bake.yml dispatch on $BUILDER_REPO main"; return 1; }
  rows="$(image_rows "$sha")" || { warn "could not read images.yaml at builder $sha"; return 1; }
  while read -r os version platform <&3; do
    name="manifest-$os-$version-$platform"
    case "$platform" in
      aws) builder=amazon-ebs ;;
      azure) builder=azure-arm ;;
      *) warn "./poc cannot verify images for platform $platform"; return 1 ;;
    esac
    manifest="$(retry_read "download $name from bake $id" download_bake_manifest "$id" "$tmp" "$name")" \
      || { warn "could not download $name from bake $id"; return 1; }
    if ! artifact="$(jq -er --arg b "$builder" '[.builds[] | select(.builder_type == $b) | .artifact_id] | select(length == 1) | .[0] | strings' \
        "$manifest")"; then
      warn "bake run $id has no single $builder artifact in $name"; return 1
    fi
    if [[ "$platform" == aws && "$artifact" =~ ^${POC_AWS_REGION}:ami-[0-9a-f]+$ ]]; then
      expected="${artifact#*:}"
    elif [[ "$platform" == azure && "$artifact" =~ ^/subscriptions/${AZURE_SUBSCRIPTION}/resourceGroups/cf-images/providers/Microsoft\.Compute/galleries/cfimages/images/[A-Za-z0-9._-]+/versions/[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      expected="$artifact"
    else
      warn "unexpected $platform artifact in $name: $artifact"; return 1
    fi
    deadline=$((SECONDS + 120))
    while ! line="$(current_image "$platform" "$os" "$version" "$fp")" \
      || ! same_image "${line%%$'\t'*}" "$expected"; do
      if (( SECONDS >= deadline )); then line=; break; fi
      sleep 5
    done
    if [[ -z "$line" ]]; then
      warn "bake $id: $platform $os $version artifact $expected is not the current usable image trusting CA $fp"
      return 1
    fi
    printf 'Bake %s %s %s %s: %s\n' "$id" "$platform" "$os" "$version" "$expected"
    verified+=("$platform $os $version $expected")
  done 3<<<"$rows"
  if [[ "$prune" == 1 ]]; then
    for line in "${verified[@]}"; do
      read -r platform os version expected <<<"$line"
      prune_superseded "$platform" "$os" "$version" "$expected" \
        || warn "could not remove every superseded $platform $os $version image; the next bake or down retries"
    done
  fi
)

# The catalog keeps entities in Postgres across redeploys; re-read every location now so changes to
# org.yaml (new users/teams) take effect immediately instead of on the next processing cycle.
refresh_catalog_locations() {
  local token refs ref payload
  token="$(tf_infra output -raw backstage_token)" || return 1
  refs="$(curl -fsS --max-time 10 -H "Authorization: Bearer $token" \
    "https://$DOMAIN/api/catalog/entities?filter=kind=location" \
    | jq -er 'select(type == "array" and length > 0) | .[] | "location:\(.metadata.namespace // "default")/\(.metadata.name)"')" || return 1
  while IFS= read -r ref; do
    payload="$(jq -nc --arg ref "$ref" '{entityRef:$ref}')" || return 1
    curl -fsS --max-time 10 -o /dev/null -X POST -H "Authorization: Bearer $token" \
      -H 'Content-Type: application/json' -d "$payload" "https://$DOMAIN/api/catalog/refresh" || return 1
  done <<<"$refs"
  echo "catalog refresh requested"
}

deploy_idp() (
  local ip="$1" mode="$2" image="${3:-}" env_file start deadline code
  local project_dir="${4:-$IDP_DIR}"
  env_file=$(mktemp "$GEN/idp.env.XXXXXX") || return 1
  trap 'rm -f "$env_file"' EXIT
  if [[ "$mode" == bootstrap ]]; then
    wait_for_ssh_ready "$ip" || return 1
    echo "host ready"
    dns_apply "$ip" || return 1
    echo "dns: $DOMAIN -> $ip"
    restore_caddy_data "$ip" || return 1
  fi
  start=$SECONDS
  write_idp_env "$env_file" || return 1
  echo "Prepare IDP configuration: $((SECONDS - start))s"
  if [[ -n "$image" ]]; then
    "$project_dir/deploy/deploy.sh" "$ip" "$env_file" "$image" || return 1
  else
    "$project_dir/deploy/deploy.sh" "$ip" "$env_file" || return 1
  fi
  start=$SECONDS
  deadline=$((SECONDS + 600))
  echo "waiting for $HEALTH_URL"
  while (( SECONDS < deadline )); do
    if code="$(curl -fsS -o /dev/null -w '%{http_code}' --max-time 5 "$HEALTH_URL" 2>/dev/null)" \
      && [[ "$code" == 200 ]] && refresh_catalog_locations; then
      echo "IDP healthy; readiness and catalog reachable after $((SECONDS - start))s"
      return 0
    fi
    sleep 2
  done
  echo "IDP readiness or authenticated catalog check failed after 10 min" >&2
  return 1
)

existing_idp_ip() {
  local ip instance actual account
  if ! ip="$(tf_infra output -raw idp_ip)" || ! instance="$(tf_infra output -raw idp_instance_id)"; then
    die "could not read the IDP host from Terraform state"
  fi
  [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ && "$instance" =~ ^i-[0-9a-f]+$ ]] || die "no valid IDP host in local state"
  account="$(aws sts get-caller-identity --query Account --output text)" && [[ "$account" == "$POC_AWS_ACCOUNT" ]] \
    || die "could not verify the POC AWS account"
  actual="$(aws ec2 describe-instances --instance-ids "$instance" \
    --filters Name=tag:cf:poc,Values=true Name=tag:cf:module,Values=infra Name=tag:Name,Values=cf-idp Name=instance-state-name,Values=running \
    --query 'Reservations[].Instances[].PublicIpAddress' --output text)"
  [[ "$actual" == "$ip" ]] || die "Terraform IP does not match a running, owned IDP"
  printf '%s\n' "$ip"
}

cmd_deploy_idp() {
  [[ $# -le 1 ]] || die "usage: ./poc deploy-idp [<sha256:image-id>]"
  if [[ $# -eq 1 && ! "$1" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    die "pass the full image ID printed by compute-factory-idp/deploy/build.sh"
  fi
  local tool ip
  for tool in terraform aws docker curl jq ssh scp; do
    type -P "$tool" >/dev/null || die "missing tool: $tool"
  done
  [[ -s "$USERS_FILE" ]] || die "no IDP users; run ./poc set-password <user> first"
  [[ -s "$ROOT/.poc.env" ]] || die "missing $ROOT/.poc.env"
  ip="$(existing_idp_ip)"
  deploy_idp "$ip" routine "${1:-}"
}

cmd_prune_idp_images() {
  [[ $# -eq 0 ]] || die "usage: ./poc prune-idp-images"
  local ip
  ip="$(existing_idp_ip)"
  "$IDP_DIR/deploy/deploy.sh" --prune "$ip"
}

require_image_tools() {
  require_tools ssh-keygen python3 "$@"
  python3 -c 'import yaml' 2>/dev/null || die "python3 needs PyYAML (pip install pyyaml) to read images.yaml"
  require_terraform_azure_auth || die "Terraform Azure authentication is required for the image tier"
  require_split_layout
}

cmd_up() (
  local resume="${1:-}"
  log "Preflight"
  require_image_tools docker scp dig
  if ! docker info >/dev/null 2>&1 || ! docker buildx version >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
    die "Docker, buildx and Compose must be usable"
  fi
  [[ -d "$CF_DNS_DIR" && -r "$CF_DNS_DIR/idp.tf" ]] || die "missing Cloudflare IDP Terraform configuration: $CF_DNS_DIR"
  [[ -r "$HOME/.ssh/id_ed25519" && -r "$HOME/.ssh/id_ed25519.pub" ]] || die "missing IDP SSH key pair"
  [[ -r "$ROOT/.poc.env" ]] || die "missing $ROOT/.poc.env (copy poc.env.example and fill it in)"
  # shellcheck disable=SC1091
  ( source "$ROOT/.poc.env" && : "${GITHUB_TOKEN:?}" ) || die ".poc.env must set GITHUB_TOKEN"
  [[ -s "$USERS_FILE" ]] || die "no IDP users; run ./poc set-password <user> first"
  # One-time Azure setup that survives down (DESIGN.md section 9).
  [[ -s "$ROOT/.poc-azure-reader.pem" ]] || die "missing $ROOT/.poc-azure-reader.pem (IDP Azure reader certificate; DESIGN.md section 9)"
  local state ip bucket tmp fp images bake_needed=0 active keys
  check_repo_variables "$BUILDER_REPO" "$PLATFORM_REPO"
  tf_infra init -input=false -lockfile=readonly >/dev/null
  state="$(infra_state)" || die "cannot read local Terraform state; refusing to apply"
  if [[ -z "$resume" ]]; then
    [[ -z "$state" ]] || die "infra state already exists; to finish bootstrap after a successful bake use ./poc up --resume <run-id>. Do not tear down to resume."
  else
    [[ -n "$state" ]] || die "no existing infra to resume; use ./poc up for a clean start"
  fi
  verify_inventory_empty || die "platform main has a nonempty or unreadable VM inventory; refusing to reset it during up"
  ensure_repos
  tmp="$(mktemp -d "$GEN/up.XXXXXX")"
  trap 'rm -rf "$tmp"' EXIT
  git clone -q --depth 1 --branch main "git@github.com:$OWNER/compute-factory-idp.git" "$tmp/idp"

  if [[ -n "$resume" ]]; then
    log "Check existing bootstrap"
    verify_maintenance_gate 1 "$PLATFORM_REPO" || die "platform is not gated; cannot resume a running POC"
    active="$(active_runs)" && [[ -z "$active" ]] || die "cannot prove both resource workflows are idle"
    ip="$(existing_idp_ip)" || die "cannot verify the existing IDP host"
    bucket="$(tf_infra output -raw state_bucket)"
    [[ "$bucket" == "$STATE_BUCKET" ]] || die "unexpected state bucket in Terraform outputs"
    keys="$(state_bucket_keys require-present)" && [[ -z "$keys" ]] \
      || die "state bucket is missing, nonempty or unreadable; cannot resume bootstrap"
    fp="$(tf_images output -raw ssh_ca_fingerprint)" && [[ "$fp" =~ $CA_FINGERPRINT_RE ]] \
      && [[ "$(ca_fingerprint_from_ssm)" == "$fp" ]] || die "cannot verify the existing POC SSH CA"
  else
    log "Keep resource workflows closed during bootstrap"
    set_maintenance_gate 1 "$BUILDER_REPO" "$PLATFORM_REPO"
    workflow_action disable "${WORKFLOW_SPECS[@]}"
    verify_quiescent || die "cannot verify bootstrap freeze and workflow quiescence"
    verify_cloud_clean 1 || die "cannot prove a clean cloud/DNS starting point (only the SSH CA and golden images may remain); inspect the checks above"
    verify_quiescent || die "resource workflows changed during preflight; refusing to apply"

    log "Image tier (SSH CA, Azure gallery)"
    fp="$(apply_images_root)" || die "image tier not ready (see $GEN/logs/images-apply.log)"
    info "SSH CA $fp"
    if images="$(current_images "$fp" main)"; then
      info "reusing images that trust this CA; no bake"
    elif [[ "$?" == 1 ]]; then
      bake_needed=1
    else
      die "image availability is unknown; no bake was dispatched and shared infra was not applied. Retry ./poc up."
    fi

    log "Shared AWS infra (state bucket, IDP host, tokens)"
    infra_apply_or_destroy apply >"$GEN/logs/infra-apply.log" 2>&1 \
      || { tail -40 "$GEN/logs/infra-apply.log" >&2; die "infra apply failed"; }
    ip="$(tf_infra output -raw idp_ip)"; bucket="$(tf_infra output -raw state_bucket)"
    [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ && "$bucket" == "$STATE_BUCKET" ]] || die "infra returned an unexpected host or state bucket"
  fi
  info "IDP host $ip, state bucket $bucket"

  log "Golden images"
  if [[ -n "$resume" ]]; then
    verify_bake_images "$resume" "$fp" 0 >"$GEN/logs/bake-resume.log" 2>&1 \
      || { tail -30 "$GEN/logs/bake-resume.log" >&2; die "existing bake $resume not verified; nothing was dispatched or pruned"; }
    images="$(current_images "$fp" main)" || die "could not verify current images for builder main; platform remains gated"
  elif [[ "$bake_needed" == 1 ]]; then
    set_maintenance_gate 0 "$BUILDER_REPO"
    verify_maintenance_gate 0 "$BUILDER_REPO" || die "builder maintenance gate did not open"
    workflow_action enable "$BUILDER_REPO:bake.yml"
    info "baking every images.yaml row; live log: $GEN/logs/bake.log"
    run_bake "$fp" >"$GEN/logs/bake.log" 2>&1 \
      || { tail -30 "$GEN/logs/bake.log" >&2; die "bake not verified; platform remains gated. Check the exact bake run; after success use ./poc up --resume <run-id>."; }
    images="$(current_images "$fp" main)" || die "could not verify current images for builder main; platform remains gated. Use ./poc up --resume <run-id>."
  fi
  report_images "$images"

  log "GitHub wiring"
  gh variable set TF_STATE_BUCKET -R "$PLATFORM_REPO" -b "$bucket"
  gh variable set BACKSTAGE_URL -R "$PLATFORM_REPO" -b "https://$DOMAIN"
  tf_infra output -raw backstage_token | gh secret set BACKSTAGE_TOKEN -R "$PLATFORM_REPO"
  set_maintenance_gate 0 "$BUILDER_REPO"
  verify_maintenance_gate 0 "$BUILDER_REPO" || die "builder maintenance gate did not open"
  workflow_action enable "$BUILDER_REPO:bake.yml"

  log "Bootstrap IDP"
  verify_maintenance_gate 1 "$PLATFORM_REPO" || die "platform gate changed; refusing to publish the IDP"
  info "live log: $GEN/logs/idp.log"
  deploy_idp "$ip" bootstrap "" "$tmp/idp" >"$GEN/logs/idp.log" 2>&1 \
    || { tail -35 "$GEN/logs/idp.log" >&2; die "IDP bootstrap failed; the platform remains gated. Inspect the log before retrying."; }

  log "Enable VM stages"
  workflow_action enable "$PLATFORM_REPO:stage.yml"
  set_maintenance_gate 0 "$PLATFORM_REPO"
  verify_maintenance_gate 0 "$PLATFORM_REPO" || die "platform maintenance gate did not open"

  log "Up"
  info "IDP:          https://$DOMAIN"
  info "SSH CA:       $fp"
  info "IDP host:     ssh ubuntu@$ip"
)

# Bake and verify every images.yaml row, whether the POC is up or down. The builder gate and bake
# workflow are returned to their previous state afterwards, also on failure.
cmd_images_only() (
  log "Preflight"
  require_image_tools
  check_repo_variables "$BUILDER_REPO"
  local prev_gate prev_workflow fp images
  prev_gate="$(gh_read variable get "$MAINTENANCE_VARIABLE" -R "$BUILDER_REPO")" || die "could not read the builder gate"
  [[ "$prev_gate" == 0 || "$prev_gate" == 1 ]] || die "builder $MAINTENANCE_VARIABLE is '$prev_gate'; run up or down first"
  prev_workflow="$(gh_read api "repos/$BUILDER_REPO/actions/workflows/bake.yml" --jq .state)" || die "could not read bake.yml state"
  [[ "$prev_workflow" == active || "$prev_workflow" == disabled_manually ]] || die "unexpected bake.yml state: $prev_workflow"

  log "Image tier (SSH CA, Azure gallery)"
  fp="$(apply_images_root)" || die "image tier not ready (see $GEN/logs/images-apply.log)"
  info "SSH CA $fp"

  log "Bake every images.yaml row"
  # shellcheck disable=SC2329 # invoked by the EXIT trap
  restore_builder() {
    local status=$?
    trap - EXIT
    log "Restore builder gate ($MAINTENANCE_VARIABLE=$prev_gate, bake.yml $prev_workflow)"
    if [[ "$prev_workflow" == disabled_manually ]]; then workflow_action disable "$BUILDER_REPO:bake.yml"; fi
    if [[ "$prev_gate" == 1 ]]; then
      set_maintenance_gate 1 "$BUILDER_REPO"
      verify_maintenance_gate 1 "$BUILDER_REPO" || die "could not restore the builder gate"
      [[ "$status" == 0 ]] || warn "if the bake is still running, ./poc down cancels it and sweeps its build resources"
    fi
    exit "$status"
  }
  trap restore_builder EXIT
  set_maintenance_gate 0 "$BUILDER_REPO"
  verify_maintenance_gate 0 "$BUILDER_REPO" || die "builder maintenance gate did not open"
  workflow_action enable "$BUILDER_REPO:bake.yml"
  info "live log: $GEN/logs/bake.log"
  run_bake "$fp" >"$GEN/logs/bake.log" 2>&1 \
    || { tail -30 "$GEN/logs/bake.log" >&2; die "bake not verified; see $GEN/logs/bake.log"; }
  images="$(current_images "$fp" main)" || die "baked images are not current for builder main"
  log "Images"
  report_images "$images"
)

# ---------------------------------------------------------------- down

workflow_action() {
  local action="$1" spec repo workflow state
  shift
  for spec in "$@"; do
    repo="${spec%%:*}"
    workflow="${spec#*:}"
    state="$(gh_read workflow list --all -R "$repo" --json path,state \
      --jq ".[] | select(.path == \".github/workflows/$workflow\") | .state")" \
      || die "could not inspect $repo/$workflow; refusing to continue"
    [[ -n "$state" ]] || die "$repo/$workflow was not found; refusing to continue"
    if [[ "$action" == disable && "$state" == disabled_manually ]]; then
      info "$repo/$workflow already disabled ($state)"
      continue
    fi
    if [[ "$action" == enable && "$state" == active ]]; then
      info "$repo/$workflow already enabled"
      continue
    fi
    gh workflow "$action" "$workflow" -R "$repo" >/dev/null \
      || warn "could not confirm $action of $repo/$workflow from the write response; checking current state"
    state="$(gh_read api "repos/$repo/actions/workflows/$workflow" --jq '.state')" \
      || die "could not confirm $action of $repo/$workflow"
    if [[ "$action" == enable && "$state" != active ]] || [[ "$action" == disable && "$state" != disabled_manually ]]; then
      die "could not confirm $action of $repo/$workflow (state: $state)"
    fi
    info "$action $repo/$workflow"
  done
}

verify_workflows_disabled() {
  local spec repo workflow state
  for spec in "${WORKFLOW_SPECS[@]}"; do
    repo="${spec%%:*}"
    workflow="${spec#*:}"
    state="$(gh_read api "repos/$repo/actions/workflows/$workflow" --jq '.state')" \
      || { warn "could not inspect $repo/$workflow"; return 1; }
    [[ -n "$state" ]] \
      || { warn "$repo/$workflow was not found"; return 1; }
    [[ "$state" == disabled_manually ]] \
      || { warn "$repo/$workflow is not manually disabled (state: $state)"; return 1; }
  done
}

verify_frozen() {
  verify_maintenance_gate 1 "$BUILDER_REPO" "$PLATFORM_REPO" && verify_workflows_disabled
}

list_active_runs() {
  local repo="$1" workflow="$2"
  gh_read api --paginate "repos/$repo/actions/workflows/$workflow/runs?per_page=100" \
    --jq '.workflow_runs[] | select(.status != "completed") | .id'
}

active_runs() {
  local repo spec
  for spec in "${WORKFLOW_SPECS[@]}"; do
    repo="${spec%%:*}"
    list_active_runs "$repo" "${spec#*:}" | awk -v repo="$repo" 'NF {print repo ":" $0}' || return 1
  done
}

cancel_runs() {
  local repo id active item deadline empty=0
  deadline=$((SECONDS + RUN_CANCEL_TIMEOUT))
  while (( SECONDS < deadline )); do
    active="$(active_runs)" || die "could not verify workflow quiescence; refusing to continue"
    if [[ -z "$active" ]]; then
      empty=$((empty + 1))
      if (( empty == 2 )); then return 0; fi
    else
      empty=0
      while IFS=: read -r repo id; do
        [[ "$id" =~ ^[1-9][0-9]*$ ]] || die "unexpected workflow run ID; refusing to continue"
        if gh run cancel "$id" -R "$repo" >/dev/null 2>&1; then
          info "requested cancellation of $repo run $id"
        else
          warn "$repo run $id is not cancellable yet or already finishing"
        fi
      done <<<"$active"
    fi
    sleep 10
  done
  for item in $active; do printf '    %s\n' "$item" >&2; done
  die "resource-creating workflows are still active after ${RUN_CANCEL_TIMEOUT}s; refusing to sweep"
}

# Caddy's TLS cert/account storage is kept on the laptop across cycles, so `up` doesn't hit
# Let's Encrypt's duplicate-certificate limit (5/week). Compose project "idp" (dir /opt/idp).
CADDY_BACKUP="$GEN/caddy-data.tgz"
CADDY_VOLUME="idp_caddy_data"

save_caddy_data() {
  local ip="$1" tmp
  [[ -n "$ip" ]] || return 0
  tmp="$(mktemp "$GEN/caddy-data.XXXXXX")" || return 1
  # Caddy is already on the host; avoid pulling a Docker Hub image during teardown.
  if ssh "${SSH_OPTS[@]}" "ubuntu@$ip" 'cd /opt/idp && docker compose exec -T caddy tar cz -C /data .' >"$tmp" 2>/dev/null \
     && tar tzf "$tmp" 2>/dev/null | grep '\.crt$' >/dev/null; then
    if mv "$tmp" "$CADDY_BACKUP"; then
      info "saved TLS cert storage to $CADDY_BACKUP"
    else
      rm -f "$tmp"
      return 1
    fi
  else
    rm -f "$tmp"; info "no TLS cert to save (keeping any previous backup)"
  fi
}

restore_caddy_data() {
  local ip="$1"
  if ! tar tzf "$CADDY_BACKUP" 2>/dev/null | grep '\.crt$' >/dev/null; then
    echo "no valid saved TLS cert; Caddy will request one"
    return 0
  fi
  # shellcheck disable=SC2029
  ssh "${SSH_OPTS[@]}" "ubuntu@$ip" "running=\$(docker ps -q \
        --filter label=com.docker.compose.project=idp --filter label=com.docker.compose.service=caddy) \
    && if [ -n \"\$running\" ]; then echo 'Caddy is already running; keeping its TLS storage'; else docker volume create \
      --label com.docker.compose.project=idp --label com.docker.compose.volume=caddy_data $CADDY_VOLUME >/dev/null \
    && docker run --rm -i -v $CADDY_VOLUME:/data alpine tar xz -C /data \
    && echo 'restored saved TLS cert storage'; fi" <"$CADDY_BACKUP" || return 1
}

stop_idp() {
  local instances instance_id state ip failed=0
  instances="$(aws ec2 describe-instances --filters Name=tag:Name,Values=cf-idp Name=tag:cf:poc,Values=true \
    Name=tag:cf:module,Values=infra Name=instance-state-name,Values=pending,running,stopping,stopped,shutting-down \
    --query 'Reservations[].Instances[].[InstanceId,State.Name,PublicIpAddress]' --output text)" \
    || { warn "could not discover owned IDP instances"; return 1; }
  [[ -n "$instances" ]] || return 0
  while IFS=$'\t' read -r instance_id state ip; do
    case "$state" in
      stopped|shutting-down|terminated) ;;
      stopping)
        aws ec2 wait instance-stopped --instance-ids "$instance_id" || { failed=1; continue; }
        ;;
      pending|running)
        if [[ "$state" == running && "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
          save_caddy_data "$ip" || warn "could not save TLS storage; keeping any previous backup"
        fi
        if [[ "$state" == pending ]]; then
          aws ec2 wait instance-running --instance-ids "$instance_id" || { failed=1; continue; }
        fi
        if ! aws ec2 stop-instances --instance-ids "$instance_id" >/dev/null \
          || ! aws ec2 wait instance-stopped --instance-ids "$instance_id"; then
          failed=1
          continue
        fi
        ;;
      *) warn "unexpected IDP instance state '$state'"; failed=1; continue ;;
    esac
    info "IDP instance quiesced: $instance_id ($state)"
  done <<<"$instances"
  [[ "$failed" == 0 ]]
}

cmd_destroy_vm() (
  local mirror="$1" platform="$2" name="$3" lock_id="$4" log_file
  local bucket="$STATE_BUCKET"
  local key="vms/$platform/$name/terraform.tfstate"
  local dir="$PLATFORM_DIR/terraform/platforms/$platform"
  [[ -d "$dir" ]] || { warn "[$platform/$name] no Terraform root; keeping state"; return 1; }
  if [[ "$platform" == azure ]]; then require_terraform_azure_auth || return 1; fi
  unset TF_PLUGIN_CACHE_DIR
  TF_DATA_DIR="$(mktemp -d "$GEN/tf-vm.XXXXXX")" || return 1
  export TF_DATA_DIR
  trap 'rm -rf "$TF_DATA_DIR"' EXIT
  log_file="$GEN/logs/vm-$platform-$name.log"
  if terraform -chdir="$dir" init -input=false -reconfigure -lockfile=readonly -plugin-dir="$mirror" \
       -backend-config="bucket=$bucket" -backend-config="key=$key" \
       -backend-config="region=$POC_AWS_REGION" -backend-config="use_lockfile=true" >"$log_file" 2>&1 \
     && { [[ "$lock_id" == - ]] || terraform -chdir="$dir" force-unlock -force "$lock_id" >>"$log_file" 2>&1; } \
     && terraform -chdir="$dir" destroy -auto-approve -input=false -var "name=$name" >>"$log_file" 2>&1 \
     && aws s3api delete-object --bucket "$bucket" --key "$key" >>"$log_file" 2>&1; then
    info "[$platform/$name] destroyed"
  else
    warn "[$platform/$name] teardown failed; preserving state (see $log_file)"
    return 1
  fi
)

# Match an account-owned bucket by exact name. HeadBucket cannot distinguish absent from inaccessible.
find_state_bucket() {
  local bucket="$1"
  aws s3api list-buckets --prefix "$bucket" --query "Buckets[?Name=='$bucket'].Name" --output text
}

state_bucket_keys() {
  local owned tags
  owned="$(find_state_bucket "$STATE_BUCKET")" || return 1
  if [[ -z "$owned" ]]; then
    [[ "${1:-}" != require-present ]] || return 2
    return 0
  fi
  [[ "$owned" == "$STATE_BUCKET" ]] || return 1
  if ! tags="$(aws s3api get-bucket-tagging --bucket "$STATE_BUCKET" --query TagSet --output json)" \
    || ! owned_infra_tags <<<"$tags"; then
    warn "cannot establish ownership of bucket $STATE_BUCKET"
    return 1
  fi
  aws s3api list-objects-v2 --bucket "$STATE_BUCKET" --output json \
    | jq -r '.Contents[]?.Key' || return 1
}

prepare_vm_states() {
  local plan="$1" scratch="$2" keys key lock_id created epoch now keys_vm platform name
  : >"$plan" || return 1
  keys="$(state_bucket_keys)" || { warn "cannot inventory $STATE_BUCKET"; return 1; }
  [[ -n "$keys" ]] || return 0
  while IFS= read -r key; do
    [[ "$key" =~ ^vms/[a-z][a-z0-9-]*/[a-z][a-z0-9-]{2,20}/terraform\.tfstate(\.tflock)?$ ]] \
      || { warn "unexpected key in $STATE_BUCKET: $key; refusing to assume it is safe to sweep"; return 1; }
  done <<<"$keys"
  if [[ "$keys" == *terraform.tfstate.tflock* ]]; then
    aws s3 sync "s3://$STATE_BUCKET/vms/" "$scratch/" --exclude '*' --include '*/terraform.tfstate.tflock' --only-show-errors \
      || return 1
  fi
  now="$(date +%s)" || return 1
  keys_vm="$(printf '%s\n' "$keys" | sed 's/\.tflock$//' | sort -u)" || return 1
  while IFS=/ read -r _ platform name _; do
    lock_id=-
    key="vms/$platform/$name/terraform.tfstate.tflock"
    if grep -Fxq "$key" <<<"$keys"; then
      lock_id="$(jq -er '.ID | strings | select(test("^[0-9a-fA-F-]{36}$"))' "$scratch/${key#vms/}")" || return 1
      created="$(jq -er '.Created | strings' "$scratch/${key#vms/}")" || return 1
      epoch="$(python3 -c 'import datetime,sys; print(int(datetime.datetime.fromisoformat(sys.argv[1].replace("Z","+00:00")).timestamp()))' "$created")" || return 1
      if (( now - epoch <= 1200 )); then
        warn "$platform/$name has a recent state lock; retry after the operator stops or the interrupted runner lock is older than 20 minutes"
        return 1
      fi
    fi
    printf '%s %s %s\n' "$platform" "$name" "$lock_id" >>"$plan" || return 1
  done <<<"$keys_vm"
}

destroy_vms() {
  local plan="$1" mirror="$2" platform
  [[ -s "$plan" ]] || { info "no VM state"; return 0; }
  mkdir -p "$mirror" || return 1
  # Populate one mirror serially, then each worker uses it read-only.
  while IFS= read -r platform; do
    [[ -d "$PLATFORM_DIR/terraform/platforms/$platform" ]] || return 1
    terraform -chdir="$PLATFORM_DIR/terraform/platforms/$platform" providers mirror -var name=poc-mirror "$mirror" \
      >"$GEN/logs/mirror-$platform.log" 2>&1 || { warn "provider mirror failed: $GEN/logs/mirror-$platform.log"; return 1; }
  done < <(awk '{print $1}' "$plan" | sort -u)
  export CF_POC_PLATFORM_DIR="$PLATFORM_DIR"
  xargs -n 3 -P "$PARALLEL_DESTROYS" "$ROOT/poc" _destroy_vm "$mirror" <"$plan"
}

# Remove POC-tagged EC2 leftovers in the pinned region.
sweep_tagged() {
  local exclude_infra="$1" keep_images="$2" ids q ami_query snapshot_query volume_query eni_query eip_query sg_query key_query
  local tagged_ids failed=0
  info "sweeping AWS region $POC_AWS_REGION"
  q='Reservations[].Instances[].InstanceId'
  # shellcheck disable=SC2016
  [[ "$exclude_infra" == "1" ]] && q='Reservations[].Instances[] | [?!(Tags[?Key==`cf:module`&&Value==`infra`])].InstanceId'
  tagged_ids="$(aws ec2 describe-instances --filters Name=tag:cf:poc,Values=true \
    Name=instance-state-name,Values=pending,running,stopping,stopped,shutting-down \
    --query "$q" --output text)" || { failed=1; tagged_ids=; }
  ids="$(printf '%s\n' "$tagged_ids" | tr '\t' '\n' | awk 'NF && $0 != "None"' | sort -u)"
  local instance_ids=()
  if [[ -n "$ids" ]]; then
    while IFS= read -r id; do instance_ids+=("$id"); done <<<"$ids"
    info "terminating instances: ${instance_ids[*]}"
    if aws ec2 terminate-instances --instance-ids "${instance_ids[@]}" >/dev/null; then
      aws ec2 wait instance-terminated --instance-ids "${instance_ids[@]}" || failed=1
    else
      failed=1
    fi
  fi

  ami_query='Images[].ImageId'
  snapshot_query='Snapshots[].SnapshotId'
  volume_query='Volumes[].VolumeId'
  eni_query='NetworkInterfaces[].NetworkInterfaceId'
  eip_query='Addresses[].AllocationId'
  sg_query='SecurityGroups[].GroupId'
  key_query='KeyPairs[].KeyPairId'
  if [[ "$exclude_infra" == "1" ]]; then
    # shellcheck disable=SC2016
    ami_query='Images[?!(Tags[?Key==`cf:module`&&Value==`infra`])].ImageId'
    # shellcheck disable=SC2016
    snapshot_query='Snapshots[?!(Tags[?Key==`cf:module`&&Value==`infra`])].SnapshotId'
    # shellcheck disable=SC2016
    volume_query='Volumes[?!(Tags[?Key==`cf:module`&&Value==`infra`])].VolumeId'
    # shellcheck disable=SC2016
    eni_query='NetworkInterfaces[?!(TagSet[?Key==`cf:module`&&Value==`infra`])].NetworkInterfaceId'
    # shellcheck disable=SC2016
    eip_query='Addresses[?!(Tags[?Key==`cf:module`&&Value==`infra`])].AllocationId'
    # shellcheck disable=SC2016
    sg_query='SecurityGroups[?!(Tags[?Key==`cf:module`&&Value==`infra`])].GroupId'
    # shellcheck disable=SC2016
    key_query='KeyPairs[?!(Tags[?Key==`cf:module`&&Value==`infra`])].KeyPairId'
  fi

  local amis ami snapshots s volumes v enis eni eips a sgs sg keys key result id
  if [[ "$keep_images" == 0 ]]; then
    amis="$(aws ec2 describe-images --include-disabled --include-deprecated --owners self --filters Name=tag:cf:poc,Values=true \
      --query "$ami_query" --output text)" || { failed=1; amis=; }
    for ami in $amis; do
      delete_aws "AMI $ami" InvalidAMIID.NotFound aws ec2 deregister-image --image-id "$ami" || failed=1
    done
    # First deregister all owned AMIs; only delete independently owned snapshots.
    snapshots="$(aws ec2 describe-snapshots --owner-ids self --filters Name=tag:cf:poc,Values=true \
      --query "$snapshot_query" --output text)" || { failed=1; snapshots=; }
    for s in $snapshots; do
      delete_aws "snapshot $s" InvalidSnapshot.NotFound aws ec2 delete-snapshot --snapshot-id "$s" || failed=1
    done
  fi

  volumes="$(aws ec2 describe-volumes --filters Name=tag:cf:poc,Values=true Name=status,Values=available \
    --query "$volume_query" --output text)" || { failed=1; volumes=; }
  for v in $volumes; do
    delete_aws "volume $v" InvalidVolume.NotFound aws ec2 delete-volume --volume-id "$v" || failed=1
  done

  enis="$(aws ec2 describe-network-interfaces --filters Name=tag:cf:poc,Values=true Name=status,Values=available \
    --query "$eni_query" --output text)" || { failed=1; enis=; }
  for eni in $enis; do
    delete_aws "network interface $eni" InvalidNetworkInterfaceID.NotFound aws ec2 delete-network-interface --network-interface-id "$eni" || failed=1
  done

  eips="$(aws ec2 describe-addresses --filters Name=tag:cf:poc,Values=true \
    --query "$eip_query" --output text)" || { failed=1; eips=; }
  for a in $eips; do
    delete_aws "EIP $a" InvalidAllocationID.NotFound aws ec2 release-address --allocation-id "$a" || failed=1
  done

  sgs="$(aws ec2 describe-security-groups --filters Name=tag:cf:poc,Values=true \
    --query "$sg_query" --output text)" || { failed=1; sgs=; }
  for sg in $sgs; do
    for _ in 1 2 3 4 5 6; do # ENIs of just-terminated instances take a moment to go away
      if result="$(aws ec2 delete-security-group --group-id "$sg" 2>&1)" || aws_error "$result" InvalidGroup.NotFound; then
        info "deleted $sg"
        break
      fi
      [[ "$result" == *'(DependencyViolation)'* ]] || break
      sleep 10
    done
    if result="$(aws ec2 describe-security-groups --group-ids "$sg" 2>&1)"; then
      warn "security group $sg still exists after delete attempts"
      failed=1
    elif ! aws_error "$result" InvalidGroup.NotFound; then
      warn "could not verify security group $sg: $result"
      failed=1
    fi
  done

  keys="$(aws ec2 describe-key-pairs --filters Name=tag:cf:poc,Values=true --query "$key_query" --output text)" \
    || { failed=1; keys=; }
  for key in $keys; do
    delete_aws "key pair $key" InvalidKeyPair.NotFound aws ec2 delete-key-pair --key-pair-id "$key" || failed=1
  done
  [[ "$failed" == 0 ]]
}

aws_error() {
  [[ "$1" == *"An error occurred ($2) when calling the "* ]]
}

delete_aws() {
  local label="$1" not_found="$2" result
  shift 2
  if result="$("$@" 2>&1)" || aws_error "$result" "$not_found"; then
    info "removed $label"
  else
    warn "could not remove $label: $result"
    return 1
  fi
}

# Azure: every VM and Packer build has its own resource group tagged cf:poc=true; the image tier's
# gallery group cf-images is cf:module=images.
sweep_azure() {
  local exclude_infra="$1" keep_gallery="$2" q groups g failed=0
  local queued=()
  q="tags.\"cf:poc\"=='true'"
  if [[ "$exclude_infra" == "1" ]]; then q+=" && tags.\"cf:module\"!='infra'"; fi
  if [[ "$keep_gallery" == "1" ]]; then q+=" && tags.\"cf:module\"!='images' && name!='cf-images'"; fi
  q="[?$q]"
  groups="$(az_poc group list --query "$q.name" -o tsv)" || return 1
  for g in $groups; do
    if az_poc group delete -n "$g" --yes --no-wait; then
      queued+=("$g")
      info "deleting resource group $g"
    else
      failed=1
    fi
  done
  if [[ -n "${queued[0]:-}" ]]; then
    for g in "${queued[@]}"; do az_poc group wait -n "$g" --deleted --timeout 1800 || failed=1; done
  fi
  [[ "$failed" == 0 ]]
}

# Packer publishes gallery image versions outside Terraform; an image definition cannot be deleted with them.
delete_image_versions() {
  local exists gallery definitions versions i v failed=0
  exists="$(az_poc group exists -n cf-images -o tsv)" || return 1
  case "$exists" in
    false) return 0 ;;
    true) ;;
    *) warn "unexpected Azure response while checking for cf-images: $exists"; return 1 ;;
  esac
  az_poc group show -n cf-images --query tags -o json \
    | jq -e '."cf:poc" == "true" and ."cf:module" == "images"' >/dev/null \
    || { warn "cannot establish ownership of Azure resource group cf-images"; return 1; }
  gallery="$(az_poc sig list -g cf-images --query "[?name=='cfimages'].name" -o tsv)" || return 1
  [[ -n "$gallery" ]] || return 0
  definitions="$(az_poc sig image-definition list -g cf-images -r cfimages --query '[].name' -o tsv)" || return 1
  for i in $definitions; do
    versions="$(az_poc sig image-version list -g cf-images -r cfimages -i "$i" --query '[].name' -o tsv)" || { failed=1; continue; }
    for v in $versions; do
      info "deleting Azure gallery image version $i/$v (can take several minutes)"
      az_poc sig image-version delete -g cf-images -r cfimages -i "$i" -e "$v" || failed=1
    done
  done
  [[ "$failed" == 0 ]]
}

owned_tags() { # $1 = cf:module value; reads an AWS tag list
  jq -e --arg m "$1" 'any(.[]?; .Key == "cf:poc" and .Value == "true") and any(.[]?; .Key == "cf:module" and .Value == $m)' >/dev/null
}
owned_infra_tags() { owned_tags infra; }

remove_empty_state_bucket() {
  local owned versions keys
  keys="$(state_bucket_keys)" || return 1
  [[ -z "$keys" ]] || { warn "state bucket still has VM state/lock objects"; return 1; }
  owned="$(find_state_bucket "$STATE_BUCKET")" || return 1
  [[ -n "$owned" ]] || return 0
  [[ "$owned" == "$STATE_BUCKET" ]] || return 1
  versions="$(aws s3api list-object-versions --bucket "$STATE_BUCKET" --output json \
    | jq -r '(.Versions[]?, .DeleteMarkers[]?).Key')" || return 1
  [[ -z "$versions" ]] || { warn "state bucket still has objects or versions; it will not be removed"; return 1; }
  # Delete it without force before the shared destroy, including when older local
  # Terraform state still records force_destroy=true on the bucket.
  delete_aws "state bucket $STATE_BUCKET" NoSuchBucket aws s3api delete-bucket --bucket "$STATE_BUCKET"
}

# Fallback when Terraform state was lost. Names are not sufficient proof of ownership.
# $1 = 1 when the image tier (SSH CA) is being removed too.
sweep_infra_orphans() {
  local sweep_ca="$1" result secret module policies p failed=0
  for secret in compute-factory/ssh-ca compute-factory/azure-reader; do
    module=infra
    if [[ "$secret" == compute-factory/ssh-ca ]]; then
      [[ "$sweep_ca" == 1 ]] || continue
      module=images
    fi
    if result="$(aws secretsmanager describe-secret --secret-id "$secret" --output json 2>&1)"; then
      if jq -e '.DeletedDate != null' <<<"$result" >/dev/null; then continue; fi
      if ! jq '.Tags' <<<"$result" | owned_tags "$module" \
        || ! delete_aws "$secret" ResourceNotFoundException aws secretsmanager delete-secret --secret-id "$secret" --force-delete-without-recovery; then
        warn "$secret not removed; check its ownership tags and deletion error"
        failed=1
      fi
    elif ! aws_error "$result" ResourceNotFoundException; then
      warn "cannot inspect $secret: $result"; failed=1
    fi
  done
  if [[ "$sweep_ca" != 1 ]]; then
    :
  elif result="$(aws ssm list-tags-for-resource --resource-type Parameter --resource-id /compute-factory/ssh-ca-pub --output json 2>&1)"; then
    if ! jq '.TagList' <<<"$result" | owned_tags images \
      || ! delete_aws "CA public parameter" ParameterNotFound aws ssm delete-parameter --name /compute-factory/ssh-ca-pub; then
      warn "CA public parameter not removed; check its ownership tags and deletion error"
      failed=1
    fi
  elif ! aws_error "$result" InvalidResourceId && ! aws_error "$result" ParameterNotFound; then
    warn "cannot inspect CA public parameter: $result"; failed=1
  fi
  if result="$(aws iam get-instance-profile --instance-profile-name cf-idp --output json 2>&1)"; then
    if jq '.InstanceProfile.Tags' <<<"$result" | owned_infra_tags \
      && jq -e 'all(.InstanceProfile.Roles[]?; .RoleName == "cf-idp")' <<<"$result" >/dev/null; then
      if jq -e '.InstanceProfile.Roles | length > 0' <<<"$result" >/dev/null; then
        delete_aws "cf-idp profile role binding" NoSuchEntity aws iam remove-role-from-instance-profile \
          --instance-profile-name cf-idp --role-name cf-idp || failed=1
      fi
      delete_aws "cf-idp instance profile" NoSuchEntity aws iam delete-instance-profile --instance-profile-name cf-idp || failed=1
    else
      warn "cannot establish ownership of instance profile cf-idp or its role attachment"; failed=1
    fi
  elif ! aws_error "$result" NoSuchEntity; then
    warn "cannot inspect instance profile cf-idp: $result"; failed=1
  fi
  if result="$(aws iam get-role --role-name cf-idp --output json 2>&1)"; then
    if jq '.Role.Tags' <<<"$result" | owned_infra_tags; then
      policies="$(aws iam list-role-policies --role-name cf-idp --query 'PolicyNames' --output text)" || { failed=1; policies=; }
      for p in $policies; do
        delete_aws "inline policy $p" NoSuchEntity aws iam delete-role-policy --role-name cf-idp --policy-name "$p" || failed=1
      done
      policies="$(aws iam list-attached-role-policies --role-name cf-idp --query 'AttachedPolicies[].PolicyArn' --output text)" || { failed=1; policies=; }
      for p in $policies; do
        delete_aws "attachment $p" NoSuchEntity aws iam detach-role-policy --role-name cf-idp --policy-arn "$p" || failed=1
      done
      delete_aws "cf-idp role" NoSuchEntity aws iam delete-role --role-name cf-idp || failed=1
    else
      warn "cannot establish ownership of IAM role cf-idp"; failed=1
    fi
  elif ! aws_error "$result" NoSuchEntity; then
    warn "cannot inspect IAM role cf-idp: $result"; failed=1
  fi
  [[ "$failed" == 0 ]]
}

capture_lookup() {
  # Set the caller's local lookup variables. CLI diagnostics can be emitted
  # even after a successful request; they are not part of the result payload.
  local diagnostics status=0
  lookup_stdout=
  lookup_stderr=
  diagnostics="$(mktemp "${TMPDIR:-/tmp}/cf-poc-lookup.XXXXXX")" || return 1
  lookup_stdout="$("$@" 2>"$diagnostics")" || status=$?
  lookup_stderr="$(<"$diagnostics")"
  rm -f "$diagnostics" || return 1
  return "$status"
}

# List queries must succeed and return no matches. Point lookups must return their specific
# not-found error; permission, credential, and network failures are not evidence of absence.
verify_absent() {
  local label="$1" not_found="$2" lookup_stdout lookup_stderr
  shift 2
  if capture_lookup "$@"; then
    [[ -z "$lookup_stdout" ]] && return 0
    warn "$label still present (or lookup returned unexpected output): $lookup_stdout"
  elif [[ -n "$not_found" ]] && aws_error "$lookup_stderr" "$not_found"; then
    return 0
  else
    warn "could not verify $label: ${lookup_stderr:-lookup failed without diagnostics}"
  fi
  return 1
}

verify_dns_absent() {
  local reply
  if ! reply="$(dig @1.1.1.1 "$DOMAIN" A +noall +comments +answer +time=3 +tries=1 2>&1)"; then
    warn "could not verify DNS for $DOMAIN: $reply"
  elif [[ "$reply" != *"status: NOERROR,"* && "$reply" != *"status: NXDOMAIN,"* ]]; then
    warn "could not verify DNS for $DOMAIN: $reply"
  elif [[ "$reply" != *"ANSWER: 0,"* ]]; then
    warn "DNS $DOMAIN still resolves (may be cached; TTL 60s)"
  else
    return 0
  fi
  return 1
}

# Batch same-type ARNs by exact ID without tag filters: a tag disappearing is not deletion.
verify_tagged_ec2_gone() {
  local prefix="arn:aws:ec2:$POC_AWS_REGION:$POC_AWS_ACCOUNT:" kind arn id id_prefix filter ids="" lookup_stdout lookup_stderr
  local -a args
  [[ "$1" == "$prefix"* ]] || return 1
  kind="${1#"$prefix"}"
  kind="${kind%%/*}"
  case "$kind" in
    instance)            id_prefix=i; filter='instance-id'; args=(describe-instances --query 'Reservations[].Instances[].[InstanceId,State.Name]') ;;
    image)               id_prefix=ami; filter='image-id'; args=(describe-images --owners self --include-disabled --include-deprecated --query 'Images[].ImageId') ;;
    snapshot)            id_prefix=snap; filter='snapshot-id'; args=(describe-snapshots --owner-ids self --query 'Snapshots[].SnapshotId') ;;
    volume)              id_prefix=vol; filter='volume-id'; args=(describe-volumes --query 'Volumes[].VolumeId') ;;
    network-interface)   id_prefix=eni; filter='network-interface-id'; args=(describe-network-interfaces --query 'NetworkInterfaces[].NetworkInterfaceId') ;;
    security-group)      id_prefix=sg; filter='group-id'; args=(describe-security-groups --query 'SecurityGroups[].GroupId') ;;
    security-group-rule) id_prefix=sgr; filter='security-group-rule-id'; args=(describe-security-group-rules --query 'SecurityGroupRules[].SecurityGroupRuleId') ;;
    elastic-ip)          id_prefix=eipalloc; filter='allocation-id'; args=(describe-addresses --query 'Addresses[].AllocationId') ;;
    key-pair)            id_prefix=key; filter='key-pair-id'; args=(describe-key-pairs --query 'KeyPairs[].KeyPairId') ;;
    *) return 1 ;;
  esac
  for arn in "$@"; do
    [[ "$arn" == "$prefix$kind/"* ]] || return 1
    id="${arn#"$prefix$kind/"}"
    [[ "$id" =~ ^${id_prefix}-[0-9a-f]+$ ]] || return 1
    ids+="${ids:+,}$id"
  done
  if ! capture_lookup aws ec2 "${args[@]}" --filters "Name=$filter,Values=$ids" --output json; then
    warn "could not confirm EC2 $kind IDs $ids: ${lookup_stderr:-lookup failed without diagnostics}"
    return 1
  fi
  if [[ "$kind" == instance ]]; then
    jq -e 'type == "array" and all(.[]; (.[0] | type == "string") and .[1] == "terminated")' \
      <<<"$lookup_stdout" >/dev/null
  else
    jq -e 'type == "array" and length == 0' <<<"$lookup_stdout" >/dev/null
  fi
}

# $1 = 1 to allow the image tier: golden AMIs/snapshots (cf:managed=true) and cf:module=images resources.
verify_aws_ec2_clean() {
  local allow_images="$1" region="$POC_AWS_REGION" tagged batches failed=0 ami_query snapshot_query
  local -a arns
  ami_query='Images[].ImageId'
  snapshot_query='Snapshots[].SnapshotId'
  if [[ "$allow_images" == 1 ]]; then
    # Raw string literals: a JMESPath `true` literal is a boolean and never equals the tag value.
    ami_query="Images[?!(Tags[?Key=='cf:managed'&&Value=='true'])].ImageId"
    snapshot_query="Snapshots[?!(Tags[?Key=='cf:managed'&&Value=='true'])].SnapshotId"
  fi
  verify_absent "AWS $region instances" "" aws ec2 describe-instances \
    --filters Name=tag:cf:poc,Values=true Name=instance-state-name,Values=pending,running,stopping,stopped,shutting-down \
    --query 'Reservations[].Instances[].InstanceId' --output text || failed=1
  verify_absent "AWS $region AMIs" "" aws ec2 describe-images --include-disabled --include-deprecated --owners self \
    --filters Name=tag:cf:poc,Values=true --query "$ami_query" --output text || failed=1
  verify_absent "AWS $region snapshots" "" aws ec2 describe-snapshots --owner-ids self \
    --filters Name=tag:cf:poc,Values=true --query "$snapshot_query" --output text || failed=1
  verify_absent "AWS $region volumes" "" aws ec2 describe-volumes \
    --filters Name=tag:cf:poc,Values=true --query 'Volumes[].VolumeId' --output text || failed=1
  verify_absent "AWS $region network interfaces" "" aws ec2 describe-network-interfaces \
    --filters Name=tag:cf:poc,Values=true --query 'NetworkInterfaces[].NetworkInterfaceId' --output text || failed=1
  verify_absent "AWS $region security groups" "" aws ec2 describe-security-groups \
    --filters Name=tag:cf:poc,Values=true --query 'SecurityGroups[].GroupId' --output text || failed=1
  verify_absent "AWS $region EIPs" "" aws ec2 describe-addresses \
    --filters Name=tag:cf:poc,Values=true --query 'Addresses[].PublicIp' --output text || failed=1
  verify_absent "AWS $region key pairs" "" aws ec2 describe-key-pairs \
    --filters Name=tag:cf:poc,Values=true --query 'KeyPairs[].KeyPairId' --output text || failed=1
  # A legacy temporary build might have failed before tags were written. Report
  # candidates rather than deleting by prefix, or silently claiming absence.
  verify_absent "AWS $region possible unowned Packer instances" "" aws ec2 describe-instances \
    --filters 'Name=key-name,Values=packer_*' Name=instance-state-name,Values=pending,running,stopping,stopped,shutting-down \
    --query 'Reservations[].Instances[].InstanceId' --output text || failed=1
  verify_absent "AWS $region possible unowned Packer security groups" "" aws ec2 describe-security-groups \
    --filters 'Name=group-name,Values=packer_*' --query 'SecurityGroups[].GroupId' --output text || failed=1
  verify_absent "AWS $region possible unowned Packer key pairs" "" aws ec2 describe-key-pairs \
    --filters 'Name=key-name,Values=packer_*' --query 'KeyPairs[].KeyName' --output text || failed=1
  verify_absent "AWS possible unowned cf-idp instances" "" aws ec2 describe-instances \
    --filters Name=tag:Name,Values=cf-idp Name=instance-state-name,Values=pending,running,stopping,stopped,shutting-down \
    --query 'Reservations[].Instances[].InstanceId' --output text || failed=1
  verify_absent "AWS possible unowned cf-idp groups" "" aws ec2 describe-security-groups \
    --filters Name=group-name,Values=cf-idp --query 'SecurityGroups[].GroupId' --output text || failed=1
  verify_absent "AWS possible unowned cf-idp EIPs" "" aws ec2 describe-addresses \
    --filters Name=tag:Name,Values=cf-idp --query 'Addresses[].AllocationId' --output text || failed=1
  verify_absent "AWS possible unowned cf-idp-admin key" "" aws ec2 describe-key-pairs \
    --filters Name=key-name,Values=cf-idp-admin --query 'KeyPairs[].KeyPairId' --output text || failed=1
  tagged="$(aws resourcegroupstaggingapi get-resources --tag-filters Key=cf:poc,Values=true \
    --query 'ResourceTagMappingList' --output json)" || { warn "could not read the AWS $region tag index"; return 1; }
  batches="$(jq -er --arg keep "$allow_images" --arg prefix "arn:aws:ec2:$region:$POC_AWS_ACCOUNT:" '
    def retained:
      any(.Tags[]; .Key == "cf:module" and .Value == "images") or
      ((.ResourceARN | startswith($prefix + "image/") or startswith($prefix + "snapshot/")) and
        any(.Tags[]; .Key == "cf:managed" and .Value == "true"));
    if type != "array" or any(.[]; (.ResourceARN | type != "string") or (.Tags | type != "array") or
        (.ResourceARN | test("^arn:[^[:space:]]+$") | not)) then error("unexpected AWS tag index response")
    else map(select($keep != "1" or (retained | not)) | .ResourceARN)
      | group_by(split("/")[0]) | map(@tsv) | join("\n")
    end' <<<"$tagged")" || { warn "could not parse the AWS $region tag index"; return 1; }
  while IFS=$'\t' read -r -a arns; do
    [[ -n "${arns[0]:-}" ]] || continue
    if verify_tagged_ec2_gone "${arns[@]}"; then
      info "ignoring stale AWS tag entries verified absent or terminated in EC2: ${arns[*]}"
    else
      warn "AWS $region tag index reports resources not verified gone: ${arns[*]}"
      failed=1
    fi
  done <<<"$batches"
  [[ "$failed" == 0 ]]
}

# $1 = 1 to allow the image tier (SSH CA, cf-images gallery, golden AMIs and snapshots) to remain.
verify_cloud_clean() {
  local allow_images="$1" failed=0 ec2_pid lookup_stdout lookup_stderr
  verify_aws_ec2_clean "$allow_images" & ec2_pid=$!

  verify_absent "state bucket" "" find_state_bucket "$STATE_BUCKET" || failed=1
  if [[ "$allow_images" != 1 ]]; then
    verify_absent "CA secret" ResourceNotFoundException aws secretsmanager describe-secret \
        --secret-id compute-factory/ssh-ca --query ARN --output text || failed=1
    verify_absent "CA public key parameter" ParameterNotFound aws ssm get-parameter \
        --name /compute-factory/ssh-ca-pub --query Parameter.Name --output text || failed=1
  fi
  verify_absent "IAM role cf-idp" NoSuchEntity aws iam get-role \
    --role-name cf-idp --query Role.RoleName --output text || failed=1
  verify_absent "IAM instance profile cf-idp" NoSuchEntity aws iam get-instance-profile \
    --instance-profile-name cf-idp --query InstanceProfile.InstanceProfileName --output text || failed=1
  verify_absent "Azure reader secret" ResourceNotFoundException aws secretsmanager describe-secret \
      --secret-id compute-factory/azure-reader --query ARN --output text || failed=1
  if [[ "$allow_images" != 1 ]]; then
    verify_absent "Azure tagged groups" "" az_poc group list --query "[?tags.\"cf:poc\"=='true'].name" -o tsv || failed=1
    verify_absent "Azure cf-images group" "" az_poc group list --query "[?name=='cf-images'].id" -o tsv || failed=1
    verify_absent "Azure tagged resources" "" az_poc resource list \
        --tag 'cf:poc=true' --query '[].id' -o tsv || failed=1
  else
    verify_absent "Azure tagged groups outside the image tier" "" az_poc group list \
      --query "[?tags.\"cf:poc\"=='true' && tags.\"cf:module\"!='images' && name!='cf-images'].name" -o tsv || failed=1
    # Resource IDs differ in resource group case; compare case-insensitively.
    if capture_lookup az_poc resource list --tag 'cf:poc=true' --query '[].id' -o json; then
      lookup_stdout="$(jq -r '.[] | select(ascii_downcase | contains("/resourcegroups/cf-images/") | not)' <<<"$lookup_stdout")" \
        || { warn "could not parse Azure tagged resources"; failed=1; }
      [[ -z "$lookup_stdout" ]] || { warn "Azure tagged resources outside cf-images: $lookup_stdout"; failed=1; }
    else
      warn "could not verify Azure tagged resources: $lookup_stderr"; failed=1
    fi
  fi
  verify_dns_absent || failed=1
  wait "$ec2_pid" || failed=1
  [[ "$failed" == 0 ]]
}

verify_quiescent() {
  local active
  verify_frozen || return 1
  active="$(active_runs)" || { warn "could not verify workflow quiescence"; return 1; }
  [[ -z "$active" ]] || { warn "active resource workflow runs: $active"; return 1; }
}

verify_infra_state_empty() {
  local state
  state="$(infra_state)" || { warn "cannot read local Terraform state"; return 1; }
  [[ -z "$state" ]] || { warn "local Terraform state is not empty: $state"; return 1; }
}

verify_images_state_empty() {
  local state
  state="$(images_state)" || { warn "cannot read local image tier Terraform state"; return 1; }
  [[ -z "$state" ]] || { warn "local image tier Terraform state is not empty: $state"; return 1; }
}

verify_clean() {
  local allow_images="$1" attempt started delay
  verify_infra_state_empty || return 1
  if [[ "$allow_images" != 1 ]]; then verify_images_state_empty || return 1; fi
  for ((attempt=1; attempt<=CLEAN_MAX_ATTEMPTS; attempt++)); do
    started=$SECONDS
    verify_quiescent || return 1
    if verify_cloud_clean "$allow_images"; then
      verify_quiescent || return 1
      info "cloud/DNS checks passed (AWS $POC_AWS_REGION)"
      return 0
    fi
    warn "cloud/DNS absence not yet verified (attempt $attempt/$CLEAN_MAX_ATTEMPTS)"
    delay=$((CLEAN_RETRY_SECONDS - (SECONDS - started)))
    if (( delay > 0 && attempt < CLEAN_MAX_ATTEMPTS )); then sleep "$delay"; fi
  done
  return 1
}

platform_wiring() {
  local kind names
  for kind in variable secret; do
    names="$(gh_read "$kind" list -R "$PLATFORM_REPO" --json name)" || return 1
    jq -e 'type == "array" and all(.[]; (.name | type == "string"))' <<<"$names" >/dev/null || return 1
    jq -r '.[].name | select(. == "TF_STATE_BUCKET" or . == "BACKSTAGE_URL" or . == "BACKSTAGE_TOKEN")' <<<"$names" || return 1
  done
}

clear_platform_wiring() {
  local name kind names
  for kind in variable secret; do
    names="$(gh_read "$kind" list -R "$PLATFORM_REPO" --json name)" || return 1
    for name in TF_STATE_BUCKET BACKSTAGE_URL BACKSTAGE_TOKEN; do
      if jq -e --arg name "$name" 'any(.[]; .name == $name)' <<<"$names" >/dev/null; then
        gh "$kind" delete "$name" -R "$PLATFORM_REPO" >/dev/null \
          || warn "could not delete platform $kind $name; confirming current state"
      fi
    done
  done
  names="$(platform_wiring)" && [[ -z "$names" ]]
}

# $1 = --keep-images: keep the image tier (SSH CA, gallery, AMIs/snapshots, gallery versions).
cmd_down() (
  local retain=0
  case "${1:-}" in
    "") ;;
    --keep-images) retain=1 ;;
    *) die "usage: ./poc down [--keep-images]" ;;
  esac
  log "Preflight"
  require_tools dig
  require_split_layout
  if [[ ! "$PARALLEL_DESTROYS" =~ ^[1-9][0-9]?$ ]] || (( PARALLEL_DESTROYS > 20 )); then
    die "PARALLEL_DESTROYS must be between 1 and 20"
  fi
  local tmp PLATFORM_DIR keep_bucket=0 keep_images="$retain" azure_ok=0 versions_ok=0 images_done=0
  local infra_tf=0 images_tf=0 aws_pid state wiring dns_ok=0
  tmp="$(mktemp -d "$GEN/down.XXXXXX")"
  trap 'rm -rf "$tmp"' EXIT
  PLATFORM_DIR="$tmp/platform"

  log "Freeze: gate resource workflows and stop the owned IDP"
  set_maintenance_gate 1 "$BUILDER_REPO" "$PLATFORM_REPO"
  workflow_action disable "${WORKFLOW_SPECS[@]}"
  verify_frozen || die "NOT CLEAN: cannot verify teardown freeze"
  cancel_runs
  verify_quiescent || die "NOT CLEAN: cannot verify resource workflow quiescence"
  stop_idp || warn "could not stop every owned IDP; workflows are frozen and the owned AWS sweep will attempt termination"
  prepare_vm_states "$tmp/vms" "$tmp/locks" \
    || die "NOT CLEAN: cannot establish state and lock safety; no resource sweep was attempted"

  log "Destroy user VMs (Terraform, $PARALLEL_DESTROYS in parallel)"
  if ! git clone -q --depth 1 --branch main "git@github.com:$PLATFORM_REPO.git" "$PLATFORM_DIR"; then
    warn "could not check out canonical platform main; VM state and inventory will not be discarded"
  fi
  if ! destroy_vms "$tmp/vms" "$tmp/provider-mirror" || ! remove_empty_state_bucket; then
    keep_bucket=1
    keep_images=1
    warn "preserving $STATE_BUCKET and golden images for VM recovery; continuing to clean owned compute resources"
  fi
  verify_quiescent || die "NOT CLEAN: the resource workflows are no longer quiescent"
  if [[ "$keep_bucket" == 1 ]]; then
    prepare_vm_states "$tmp/vms" "$tmp/locks" \
      || die "NOT CLEAN: state or lock safety changed; refusing to sweep potentially active operations"
  fi

  log "Sweep owned AWS leftovers and Azure VM/build groups"
  sweep_tagged 1 "$keep_images" & aws_pid=$!
  if sweep_azure 1 1; then azure_ok=1; else warn "Azure VM/build groups remain; the image tier is preserved"; fi
  if [[ "$azure_ok" == 1 && "$keep_images" == 0 ]]; then
    if delete_image_versions; then
      versions_ok=1
    else
      warn "Azure gallery versions remain; the SSH CA and gallery are preserved until they are reconciled"
    fi
  fi
  wait "$aws_pid" || warn "some owned AWS resources could not be swept; a final sweep and verification follow"

  log "DNS: remove $DOMAIN"
  if dns_apply ""; then dns_ok=1; else warn "DNS removal failed (see $GEN/logs/dns.log)"; fi

  log "Destroy shared infra"
  if [[ "$keep_bucket" == 0 ]]; then
    if tf_infra init -input=false -lockfile=readonly >"$GEN/logs/infra-init.log" 2>&1; then
      infra_tf=1
    else
      warn "shared Terraform init failed (see $GEN/logs/infra-init.log); using the owned-resource sweep"
    fi
    if [[ "$infra_tf" == 1 ]] && state="$(infra_state)" && [[ -n "$state" ]]; then
      if ! infra_apply_or_destroy destroy >"$GEN/logs/infra-destroy.log" 2>&1; then
        tail -30 "$GEN/logs/infra-destroy.log" >&2
        warn "Terraform destroy failed; sweeping independently and then retrying the local state"
      fi
    fi
  fi
  if [[ "$versions_ok" == 1 ]]; then
    log "Destroy image tier (SSH CA, Azure gallery)"
    if ! tf_images init -input=false -lockfile=readonly >"$GEN/logs/images-init.log" 2>&1; then
      warn "image tier Terraform init failed (see $GEN/logs/images-init.log); using the owned-resource sweep"
    elif state="$(images_state)" && [[ -n "$state" ]] && require_terraform_azure_auth; then
      images_tf=1
      if ! images_apply_or_destroy destroy >"$GEN/logs/images-destroy.log" 2>&1; then
        tail -30 "$GEN/logs/images-destroy.log" >&2
        warn "image tier Terraform destroy failed; sweeping independently and then retrying the local state"
      fi
    fi
  elif [[ "$retain" == 1 ]]; then
    info "keeping the image tier (--keep-images)"
  fi
  sweep_tagged 0 "$keep_images" & aws_pid=$!
  if [[ "$azure_ok" == 1 ]]; then
    sweep_azure 0 "$((1 - versions_ok))" || { azure_ok=0; warn "final Azure sweep failed"; }
  fi
  wait "$aws_pid" || warn "final AWS $POC_AWS_REGION sweep failed"
  sweep_infra_orphans "$versions_ok" || warn "some shared AWS fallbacks failed"
  if [[ "$infra_tf" == 1 ]] && ! verify_infra_state_empty; then
    infra_apply_or_destroy destroy >>"$GEN/logs/infra-destroy.log" 2>&1 \
      || warn "shared Terraform state still needs recovery (see $GEN/logs/infra-destroy.log)"
  fi
  if [[ "$images_tf" == 1 ]] && ! verify_images_state_empty; then
    images_apply_or_destroy destroy >>"$GEN/logs/images-destroy.log" 2>&1 \
      || warn "image tier Terraform state still needs recovery (see $GEN/logs/images-destroy.log)"
  fi

  # Requested retention only needs the VM/build groups gone; full teardown also needs the gallery versions.
  if [[ "$retain" == 1 ]]; then images_done="$azure_ok"; else images_done="$versions_ok"; fi
  if [[ "$keep_bucket" == 1 || "$azure_ok" == 0 || "$images_done" == 0 || "$dns_ok" == 0 ]]; then
    log "Report remaining cloud/DNS resources"
    verify_cloud_clean "$retain" || true
    die "NOT CLEAN: teardown retained recovery state or could not complete Azure/DNS cleanup. Fix the reported blocker and rerun down."
  fi
  log "Verify cloud, DNS and local state"
  verify_clean "$retain" || die "NOT CLEAN: teardown verification failed; see the check-specific warnings above"

  log "Clear and verify GitHub wiring and inventory"
  clear_platform_wiring || die "NOT CLEAN: platform GitHub wiring could not be cleared and verified"
  if verify_inventory_empty; then
    info "inventory already empty"
  elif [[ "$?" == 1 ]]; then
    if [[ ! -d "$PLATFORM_DIR/.git" ]] || ! reset_inventory "$PLATFORM_DIR" || ! verify_inventory_empty; then
      die "NOT CLEAN: could not reset and verify platform main's VM inventory"
    fi
  else
    die "NOT CLEAN: could not read platform main's VM inventory; it was not reset. Rerun down to verify."
  fi
  verify_quiescent || die "NOT CLEAN: resource workflows are no longer quiescent"
  wiring="$(platform_wiring)" && [[ -z "$wiring" ]] || die "NOT CLEAN: platform GitHub wiring remains or could not be read"
  if [[ "$retain" == 1 ]]; then
    log "Kept image tier"
    list_image_tier
    printf '\n\033[32mCLEAN (images retained): POC cloud resources, DNS, Terraform state, GitHub wiring and inventory verified; the SSH CA and golden images above remain.\033[0m\n'
  else
    printf '\n\033[32mCLEAN: POC cloud resources, DNS, Terraform state, GitHub wiring and inventory verified.\033[0m\n'
  fi
)

# ---------------------------------------------------------------- users

# ./poc set-password <user>: add or change an IDP login. The user also needs an entry in the idp repo's
# catalog/org.yaml. Takes effect on the next deploy (./poc up or ./poc deploy-idp).
cmd_set_password() {
  local user="${1:-}" pw pw2 hash
  [[ "$user" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || die "usage: $0 set-password <username>"
  [[ -f "$IDP_DIR/deploy/hash-password.mjs" ]] || die "missing $IDP_DIR/deploy/hash-password.mjs"
  read -rsp "Password for $user: " pw; echo
  read -rsp "Repeat: " pw2; echo
  [[ "$pw" == "$pw2" ]] || die "passwords don't match"
  [[ ${#pw} -ge 8 ]] || die "use at least 8 characters"
  hash="$(printf '%s' "$pw" | (cd "$IDP_DIR" && mise exec -- node deploy/hash-password.mjs))"
  [[ -n "$hash" && "$hash" != *$'\n'* ]] || die "hashing failed"
  umask 077
  touch "$USERS_FILE"
  { grep -v "^$user:" "$USERS_FILE" || true; printf '%s:%s\n' "$user" "$hash"; } >"$USERS_FILE.tmp"
  mv "$USERS_FILE.tmp" "$USERS_FILE"
  touch "$PASSWORDS_FILE"
  { grep -v "^$user:" "$PASSWORDS_FILE" || true; printf '%s:%s\n' "$user" "$pw"; } >"$PASSWORDS_FILE.tmp"
  mv "$PASSWORDS_FILE.tmp" "$PASSWORDS_FILE"
  info "password set for $user (plaintext kept in .poc-passwords); deploy with ./poc deploy-idp"
}

# ---------------------------------------------------------------- status

cmd_status() {
  require_tools
  local state keys
  state="$(infra_state)" || die "cannot read local Terraform state"
  log "Shared infra"
  if [[ -n "$state" ]]; then
    info "IDP host:     $(infra_out idp_ip) ($(infra_out idp_instance_id))"
    info "State bucket: $(infra_out state_bucket)"
    local code
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "$HEALTH_URL" || true)"
    info "IDP health:   $([[ "$code" == 000 || -z "$code" ]] && echo unreachable || echo "HTTP $code")"
  else
    info "none"
  fi
  log "Image tier: SSH CA and golden images (id, name/state, created, CA fingerprint, git SHA)"
  list_image_tier
  log "Instances tagged cf:poc=true"
  # shellcheck disable=SC2016
  aws ec2 describe-instances --filters Name=tag:cf:poc,Values=true Name=instance-state-name,Values=pending,running,stopping,stopped \
    --query 'Reservations[].Instances[].[InstanceId,State.Name,PublicIpAddress,Tags[?Key==`Name`]|[0].Value]' --output text | sed 's/^/    /'
  log "Azure resource groups tagged cf:poc=true"
  az group list --query "[?tags.\"cf:poc\"=='true'].[name,properties.provisioningState]" -o tsv | sed 's/^/    /'
  log "VM state files"
  if keys="$(state_bucket_keys require-present)"; then
    if [[ -n "$keys" ]]; then printf '%s\n' "$keys" | sed 's/^/    /'; else info "state bucket is empty"; fi
  elif [[ "$?" == 2 ]]; then
    info "no owned state bucket"
  else
    warn "could not verify the state bucket or list its contents"
  fi
  log "Active pipeline runs"
  local repo
  for repo in "$PLATFORM_REPO" "$BUILDER_REPO"; do
    gh run list -R "$repo" -L 20 --json databaseId,status,displayTitle \
      -q '.[] | select(.status != "completed") | "    \(.databaseId) \(.status) \(.displayTitle)"' 2>/dev/null || true
  done
}

idp_host() {
  local ip
  ip="$(infra_out idp_ip)"
  [[ -n "$ip" ]] || die "no IDP host (run ./poc up)"
  echo "ubuntu@$ip"
}

# Read-only. Pipe to grep/jq locally, e.g. ./poc logs caddy 10m | grep /events
cmd_logs() {
  local service="${1:-backstage}" since="${2:-30m}"
  [[ "$service" =~ ^(backstage|caddy|postgres|all)$ ]] || die "service must be backstage, caddy, postgres or all"
  [[ "$since" =~ ^[0-9]+[smh]$ ]] || die "since must look like 30m, 2h or 90s"
  [[ "$service" == all ]] && service=""
  local host; host="$(idp_host)"
  # shellcheck disable=SC2029
  ssh "${SSH_OPTS[@]}" "$host" "cd /opt/idp && docker compose logs --no-color --no-log-prefix --since $since $service" </dev/null
}

# Read-only. If the task page is blank but events exist here, the problem is delivery to the browser.
cmd_task() {
  local id="${1:-}"
  [[ "$id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || die "usage: $0 task <task-uuid>"
  local host; host="$(idp_host)"
  # shellcheck disable=SC2029
  ssh "${SSH_OPTS[@]}" "$host" "cd /opt/idp && docker compose exec -T postgres psql -U backstage -d backstage_plugin_scaffolder \
    -c \"select status, created_at, last_heartbeat_at, created_by from tasks where id = '$id'\" \
    -c \"select id, event_type, created_at, left(body::text, 300) as body from task_events where task_id = '$id' order by id\"" </dev/null
}

# Read-only. Orchestrator state of one VM run (the IDP run page shows the same data).
cmd_run() {
  local id="${1:-}"
  [[ "$id" =~ ^[1-9][0-9]{0,9}$ ]] || die "usage: $0 run <run-id>"
  local host; host="$(idp_host)"
  # shellcheck disable=SC2029
  ssh "${SSH_OPTS[@]}" "$host" "cd /opt/idp && docker compose exec -T postgres psql -U backstage -d backstage_plugin_vms \
    -c \"select id, kind, name, team, status, requested_by, to_timestamp(created_at/1000) as created, left(error, 200) as error from vm_runs where id = $id\" \
    -c \"select stage, status, attempt, max_attempts + budget_start as max, gha_run_id, conclusion, to_timestamp(next_attempt_at/1000) as next_attempt, left(error, 160) as error from vm_run_stages where run_id = $id order by position\"" </dev/null
}

case "${1:-}" in
  up)
    [[ $# == 1 || ( $# == 2 && "$2" == --images-only ) \
      || ( $# == 3 && "$2" == --resume && "$3" =~ ^[1-9][0-9]*$ ) ]] \
      || die "usage: ./poc up [--images-only | --resume <run-id>]"
    acquire_poc_lock "$@"
    prepare_lifecycle
    ;;
  down)
    [[ $# == 1 || ( $# == 2 && "$2" == --keep-images ) ]] || die "usage: ./poc down [--keep-images]"
    acquire_poc_lock "$@"
    prepare_lifecycle
    ;;
  deploy-idp|prune-idp-images)
    acquire_poc_lock "$@"
    prepare_lifecycle
    ;;
  _destroy_vm)
    locked || die "this is an internal lifecycle worker; no lock is held"
    ;;
esac

case "${1:-}" in
  up)          if [[ "${2:-}" == --images-only ]]; then cmd_images_only; else cmd_up "${3:-}"; fi ;;
  logs)        shift; cmd_logs "$@" ;;
  task)        shift; cmd_task "$@" ;;
  run)         shift; cmd_run "$@" ;;
  down)        cmd_down "${2:-}" ;;
  status)      cmd_status ;;
  watch-bake)  command -v gh >/dev/null || die "missing tool: gh"
               command -v jq >/dev/null || die "missing tool: jq"
               watch_bake "${2:-}" ;;
  set-password) shift; cmd_set_password "$@" ;;
  deploy-idp)  shift; cmd_deploy_idp "$@" ;;
  prune-idp-images) shift; cmd_prune_idp_images "$@" ;;
  _destroy_vm) shift; PLATFORM_DIR="${CF_POC_PLATFORM_DIR:?}"; cmd_destroy_vm "$@" ;;
  *) echo "usage: $0 up [--images-only | --resume <run-id>]|down [--keep-images]|status|deploy-idp [<image-id>]|prune-idp-images|set-password <user>|watch-bake <run-id>|logs [service] [since]|task <task-id>|run <run-id>" >&2; exit 2 ;;
esac
