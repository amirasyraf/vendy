check_repo_variables() {
  local repo var value
  for repo in "$@"; do
    for var in AWS_ROLE_ARN AWS_REGION AZURE_CLIENT_ID AZURE_TENANT_ID AZURE_SUBSCRIPTION_ID AZURE_LOCATION; do
      value="$(gh_read variable get "$var" -R "$repo")" || die "could not read $var on $repo (DESIGN.md section 9)"
      [[ -n "$value" ]] || die "$repo is missing $var (DESIGN.md section 9)"
      case "$var" in
        AWS_ROLE_ARN) [[ "$value" == "arn:aws:iam::$POC_AWS_ACCOUNT:role/"* ]] || die "$repo uses an unexpected AWS role" ;;
        AWS_REGION) [[ "$value" == "$POC_AWS_REGION" ]] || die "$repo uses an unexpected AWS region" ;;
        AZURE_TENANT_ID) [[ "$value" == "$AZURE_TENANT" ]] || die "$repo uses an unexpected Azure tenant" ;;
        AZURE_SUBSCRIPTION_ID) [[ "$value" == "$AZURE_SUBSCRIPTION" ]] || die "$repo uses an unexpected Azure subscription" ;;
        AZURE_LOCATION) [[ "$value" == australiaeast ]] || die "$repo uses an unexpected Azure location" ;;
      esac
    done
  done
}

# ---------------------------------------------------------------- image tier (SSH CA + golden images)

ca_fingerprint_from_ssm() {
  local key fp
  key="$(aws ssm get-parameter --name /compute-factory/ssh-ca-pub --query Parameter.Value --output text)" || return 1
  fp="$(printf '%s\n' "$key" | ssh-keygen -lf /dev/stdin | awk '{print $2}')" || return 1
  [[ "$fp" =~ $CA_FINGERPRINT_RE ]] || return 1
  printf '%s\n' "$fp"
}

# Create the CA and gallery if missing (otherwise a no-op) and print the CA fingerprint. The bake
# reads the CA from SSM, so require SSM to hold exactly the key in this root's state.
apply_images_root() {
  local fp ssm
  tf_images init -input=false -lockfile=readonly >"$GEN/logs/images-init.log" 2>&1 \
    || { cat "$GEN/logs/images-init.log" >&2; warn "image tier Terraform init failed"; return 1; }
  images_apply_or_destroy apply >"$GEN/logs/images-apply.log" 2>&1 \
    || { tail -40 "$GEN/logs/images-apply.log" >&2; warn "image tier apply failed"; return 1; }
  fp="$(tf_images output -raw ssh_ca_fingerprint)" && [[ "$fp" =~ $CA_FINGERPRINT_RE ]] \
    || { warn "image tier returned no valid CA fingerprint"; return 1; }
  ssm="$(ca_fingerprint_from_ssm)" && [[ "$ssm" == "$fp" ]] \
    || { warn "SSM /compute-factory/ssh-ca-pub (${ssm:-unreadable}) does not match the CA in state ($fp)"; return 1; }
  printf '%s\n' "$fp"
}

# Prints "<os> <version> <platform>" for each images.yaml row at a builder ref.
image_rows() {
  local yaml
  yaml="$(gh_read api -H 'Accept: application/vnd.github.raw' "repos/$BUILDER_REPO/contents/images.yaml?ref=$1")" \
    || { warn "could not fetch images.yaml at builder $1"; return 1; }
  python3 -c '
import re, sys, yaml
rows = yaml.safe_load(sys.stdin)
if not isinstance(rows, list) or not rows:
    sys.exit("images.yaml has no rows")
for row in rows:
    values = [str(row.get(key, "")) for key in ("os", "version", "platform")]
    if not all(re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,31}", v) for v in values):
        sys.exit(f"unexpected images.yaml row: {row}")
    print(*values)
' <<<"$yaml"
}

# The gallery definition a release launches from (the platform repo's mapping, as Terraform uses it).
azure_gallery_image() {
  gh_read api -H 'Accept: application/vnd.github.raw' \
    "repos/$PLATFORM_REPO/contents/terraform/platforms/azure/platform.json?ref=main" \
    | jq -er --arg os "$1" --arg version "$2" \
      '.os[$os].galleryImages[$version] | strings | select(test("^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"))'
}

# Prints "<image-id>\t<git-sha>\t<created>" for the image a new VM of this row would launch (the
# newest one, as platform Terraform selects it), only if it is usable and trusts CA $4.
# 1 means no matching usable image; 2 means the lookup could not establish that.
current_image() {
  local platform="$1" os="$2" version="$3" fp="$4" json def line status=0
  case "$platform" in
    aws)
      json="$(aws ec2 describe-images --owners self --filters Name=tag:cf:os,Values="$os" \
        Name=tag:cf:os-version,Values="$version" Name=tag:cf:managed,Values=true --output json)" \
        && [[ -n "$json" ]] || return 2
      line="$(jq -er --arg fp "$fp" '.Images | if type == "array" then . else error("invalid Images response") end | sort_by(.CreationDate) | last
        | select(. != null and .State == "available")
        | (.Tags // [] | from_entries) as $t
        | select($t["cf:poc"] == "true" and $t["cf:ssh-ca-fingerprint"] == $fp)
        | [.ImageId, ($t["cf:git-sha"] // "unknown"), .CreationDate] | @tsv' <<<"$json")" || status=$?
      ;;
    azure)
      def="$(azure_gallery_image "$os" "$version")" \
        || { warn "could not resolve Azure gallery definition for $os $version"; return 2; }
      json="$(az_poc sig image-version list -g cf-images -r cfimages -i "$def" -o json)" \
        && [[ -n "$json" ]] || return 2
      line="$(jq -er --arg fp "$fp" --arg os "$os" --arg version "$version" '
        if type == "array" then . else error("invalid gallery response") end
        | map(select(.publishingProfile.excludeFromLatest != true))
        | sort_by(.name | split(".") | map(tonumber)) | last
        | select(. != null and .provisioningState == "Succeeded")
        | select(.tags["cf:poc"] == "true" and .tags["cf:ssh-ca-fingerprint"] == $fp
            and .tags["cf:os"] == $os and .tags["cf:os-version"] == $version)
        | [.id, (.tags["cf:git-sha"] // "unknown"), (.publishingProfile.publishedDate // "unknown")] | @tsv' <<<"$json")" || status=$?
      ;;
    *) warn "./poc cannot verify images for platform $platform"; return 2 ;;
  esac
  case "$status" in
    0) printf '%s\n' "$line" ;;
    4) return 1 ;; # jq -e: no selected result
    *) return 2 ;;
  esac
}

# Prints "<platform> <os> <version>\t<image-id>\t<git-sha>\t<created>" per images.yaml row at $2.
# Fails unless every row has a current, usable image that trusts CA $1.
current_images() {
  local fp="$1" ref="$2" rows os version platform line failed=0
  rows="$(image_rows "$ref")" || { warn "could not read images.yaml at builder $ref"; return 2; }
  while read -r os version platform <&3; do
    if line="$(current_image "$platform" "$os" "$version" "$fp")"; then
      printf '%s %s %s\t%s\n' "$platform" "$os" "$version" "$line"
    elif [[ "$?" == 1 ]]; then
      info "no current $platform $os $version image trusting CA $fp" >&2
      failed=1
    else
      warn "could not determine the current $platform $os $version image; not safe to dispatch a bake"
      return 2
    fi
  done 3<<<"$rows"
  return "$failed"
}

# Warn only: kept images are used even when builder main has moved on.
report_images() {
  local main row id sha created
  main="$(gh_read api "repos/$BUILDER_REPO/commits/main" --jq .sha)" || { warn "could not read builder main"; main=; }
  while IFS=$'\t' read -r row id sha created; do
    info "$row: $id (built $created from builder ${sha:0:7})"
    if [[ -n "$main" && "$sha" != "$main" ]]; then
      warn "$row image is from builder ${sha:0:7}, main is ${main:0:7}; run ./poc up --images-only to rebake"
    fi
  done <<<"$1"
}

same_image() {
  [[ "$(tr '[:upper:]' '[:lower:]' <<<"$1")" == "$(tr '[:upper:]' '[:lower:]' <<<"$2")" ]]
}

# After a verified bake, remove every other image of the same row so only the current one remains.
prune_superseded() {
  local platform="$1" os="$2" version="$3" keep="$4" json ami snaps s def versions v failed=0
  case "$platform" in
    aws)
      json="$(aws ec2 describe-images --include-disabled --owners self --filters Name=tag:cf:poc,Values=true \
        Name=tag:cf:managed,Values=true Name=tag:cf:os,Values="$os" Name=tag:cf:os-version,Values="$version" \
        --output json)" || return 1
      while IFS=$'\t' read -r ami snaps <&3; do
        [[ "$ami" =~ ^ami-[0-9a-f]+$ && "$ami" != "$keep" ]] || continue
        delete_aws "superseded AMI $ami" InvalidAMIID.NotFound aws ec2 deregister-image --image-id "$ami" \
          || { failed=1; continue; }
        for s in $snaps; do
          delete_aws "its snapshot $s" InvalidSnapshot.NotFound aws ec2 delete-snapshot --snapshot-id "$s" || failed=1
        done
      done 3< <(jq -r '.Images[] | [.ImageId, ([.BlockDeviceMappings[]?.Ebs.SnapshotId // empty] | join(" "))] | @tsv' <<<"$json")
      ;;
    azure)
      def="$(azure_gallery_image "$os" "$version")" || return 1
      versions="$(az_poc sig image-version list -g cf-images -r cfimages -i "$def" --query '[].name' -o tsv)" || return 1
      for v in $versions; do
        [[ "$v" != "${keep##*/}" ]] || continue
        info "deleting superseded Azure gallery version $def/$v (can take several minutes)"
        az_poc sig image-version delete -g cf-images -r cfimages -i "$def" -e "$v" || failed=1
      done
      ;;
  esac
  [[ "$failed" == 0 ]]
}

# Print the kept image tier: CA fingerprint plus every POC image with its CA fingerprint and git SHA.
list_image_tier() {
  local fp def
  if fp="$(ca_fingerprint_from_ssm 2>/dev/null)"; then info "SSH CA: $fp"; else info "SSH CA: none"; fi
  # shellcheck disable=SC2016
  aws ec2 describe-images --owners self --filters Name=tag:cf:poc,Values=true \
    --query 'Images[].[ImageId,Name,CreationDate,Tags[?Key==`cf:ssh-ca-fingerprint`]|[0].Value,Tags[?Key==`cf:git-sha`]|[0].Value]' \
    --output text | sed 's/^/    /'
  for def in $(az_poc sig image-definition list -g cf-images -r cfimages --query '[].name' -o tsv 2>/dev/null); do
    az_poc sig image-version list -g cf-images -r cfimages -i "$def" \
      --query '[].[name,provisioningState,tags."cf:ssh-ca-fingerprint",tags."cf:git-sha"]' -o tsv | sed "s/^/    $def /"
  done
}

